<%
  const videoId = video.id;
  const description = typeof video.description === 'string' ? video.description.trim() : '';
  const ready = ['ready', 'ready_with_warnings'].includes(video.validationStatus);
  const user = typeof currentUser !== 'undefined' && currentUser ? currentUser : null;
  const safeCsrfToken = typeof csrfToken === 'string' ? csrfToken : '';
  const safeTree = typeof discussionTree !== 'undefined' && Array.isArray(discussionTree) ? discussionTree : [];
  const discussionCount = Array.isArray(discussions) ? discussions.length : 0;
  const errorMessage = typeof discussionError === 'string' ? discussionError : '';
  const publisher = video.accountDisplayName || video.accountUsername || '';
  const created = video.createdAt ? new Date(video.createdAt) : null;
  const formattedDate = created && !Number.isNaN(created.getTime())
    ? new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }).format(created)
    : '';
  const duration = Number(video.durationSeconds);
  const durationText = Number.isFinite(duration)
    ? (duration >= 3600
      ? Math.floor(duration / 3600) + ' 小时 ' + Math.floor((duration % 3600) / 60) + ' 分钟'
      : (duration < 60 ? '不到 1 分钟' : Math.floor(duration / 60) + ' 分钟'))
    : '';
  const formatLabel = `${({ avc: 'H.264', hevc: 'HEVC', vp9: 'VP9', av1: 'AV1', unknown: '历史媒体' })[video.videoCodec] || video.videoCodec}${video.audioCodec ? ' + ' + video.audioCodec.toUpperCase() : ''} · ${(video.container || 'mp4').toUpperCase()}`;
  const discussionDate = function(value) {
    const date = value ? new Date(value) : null;
    return date && !Number.isNaN(date.getTime())
      ? new Intl.DateTimeFormat('zh-CN', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }).format(date)
      : '';
  };
  const plainPreview = function(value) {
    return String(value || '').replace(/[`*_>#\[\]$]/g, '').replace(/\s+/g, ' ').trim().slice(0, 140);
  };
%>
<%- include('partials/head', {
  pageTitle: video.title + '｜同见',
  pageDescription: description || ('观看 ' + video.creator + ' 创作的《' + video.title + '》。'),
  includeMathEditor: Boolean(user)
}) %>
<body class="page page--video-detail">
  <a class="skip-link" href="#main-content">跳到主要内容</a>
  <%- include('partials/header', { currentPath: '' }) %>
  <div class="app-shell shell">
    <%- include('partials/sidebar', { currentPath: '', categoryTree: categoryTree }) %>
    <main id="main-content" class="video-detail" tabindex="-1">
      <a class="detail-back" href="/">← 返回视频目录</a>

      <% if (video.validationStatus === 'ready_with_warnings') { %><div class="validation-banner validation-banner--warning" role="status"><strong>媒体已通过验证，但检测到少量可恢复问题</strong><p>个别位置在部分设备上可能短暂花屏、卡顿或出现声音异常。</p></div><% } %>

      <% if (ready) { %>
        <section class="longform-player" aria-label="视频播放器">
          <video controls playsinline preload="metadata"<% if (video.coverStorageName) { %> poster="/videos/<%= videoId %>/cover"<% } %>>
            <source src="/videos/<%= videoId %>/media" type="<%= video.mediaType %>">
            你的浏览器不支持播放此视频。<a href="/videos/<%= videoId %>/media">直接打开视频文件</a>。
          </video>
        </section>
      <% } else { %>
        <section class="validation-state" data-validation-watch data-status-url="/api/videos/<%= videoId %>/status" data-current-status="<%= video.validationStatus %>" aria-live="polite"><span class="validation-state__signal" aria-hidden="true"></span><p class="eyebrow"><span></span> 发布前安全检查</p><h2 data-validation-label><%= validationStatus.label %></h2><p><%= video.validationStatus === 'rejected' ? (video.validationSummary.message || '文件没有通过完整媒体验证。') : '服务器正在遍历媒体结构并完整解码；完成前不会公开。' %></p></section>
      <% } %>

      <header class="watch-heading">
        <div class="watch-heading__context"><% if (video.categoryName) { %><a href="/categories/<%= video.categorySlug %>"><%= video.categoryName %></a><span>·</span><% } %><span><%= formattedDate %></span><% if (durationText) { %><span>·</span><span><%= durationText %></span><% } %></div>
        <h1><%= video.title %></h1>
        <div class="watch-heading__row">
          <div class="creator-line"><span class="creator-line__avatar" aria-hidden="true"><%= Array.from(String(publisher || video.creator))[0] || '同' %></span><p><strong><%= video.creator %></strong><% if (publisher) { %><small>由 <%= publisher %> 发布</small><% } %></p></div>
          <div class="reaction-group" aria-label="视频评价">
            <% if (user) { %>
              <form action="/videos/<%= videoId %>/vote" method="post" data-vote-form><input type="hidden" name="_csrf" value="<%= safeCsrfToken %>"><button type="submit" name="value" value="<%= video.viewerVote === 1 ? 0 : 1 %>" class="reaction-button<% if (video.viewerVote === 1) { %> is-active<% } %>">认同 <strong data-upvotes><%= video.upvoteCount %></strong></button></form>
              <form action="/videos/<%= videoId %>/vote" method="post" data-vote-form><input type="hidden" name="_csrf" value="<%= safeCsrfToken %>"><button type="submit" name="value" value="<%= video.viewerVote === -1 ? 0 : -1 %>" class="reaction-button<% if (video.viewerVote === -1) { %> is-active is-negative<% } %>">反对 <strong data-downvotes><%= video.downvoteCount %></strong></button></form>
            <% } else { %><a class="reaction-button" href="/login?next=<%= encodeURIComponent('/videos/' + videoId) %>">认同 <strong><%= video.upvoteCount %></strong></a><a class="reaction-button" href="/login?next=<%= encodeURIComponent('/videos/' + videoId) %>">反对 <strong><%= video.downvoteCount %></strong></a><% } %>
          </div>
        </div>
        <% if (video.tags.length) { %><div class="tag-row"><% video.tags.forEach(function(tag) { %><a href="/tags/<%= tag.slug %>">#<%= tag.name %></a><% }); %></div><% } %>
      </header>

      <details class="compact-about">
        <summary><span><strong>关于作品</strong><small><%= description ? plainPreview(description) : '创作者没有留下更多说明' %></small></span><span>展开详情</span></summary>
        <div class="compact-about__content"><div><p><%= description || '创作者没有留下更多说明。' %></p><dl><div><dt>格式</dt><dd><%= formatLabel %></dd></div><% if (video.width) { %><div><dt>尺寸</dt><dd><%= video.width %>×<%= video.height %></dd></div><% } %><div><dt>许可</dt><dd><%= license.code %></dd></div></dl></div><aside><strong><% if (license.cc0) { %>公共领域工具 · <% } %><%= license.name %></strong><p><%= license.summary %></p><a href="<%= license.url %>" target="_blank" rel="license noopener">查看官方许可文本 ↗</a></aside></div>
      </details>

      <% if (ready) { %>
      <section class="thread-section" aria-labelledby="discussion-title">
        <header class="thread-section__header"><div><p class="eyebrow"><span></span> 围绕作品</p><h2 id="discussion-title">讨论</h2></div><p><strong><%= discussionCount %></strong> 条讨论与回复</p></header>

        <details class="topic-composer"<% if (errorMessage || discussionCount === 0) { %> open<% } %>>
          <summary><span><strong><%= user ? '发起一个讨论' : '登录后参与讨论' %></strong><small><%= user ? '添加标题，让其他人先了解你想谈什么' : '观看始终开放，发言需要稳定账号' %></small></span><span aria-hidden="true">＋</span></summary>
          <% if (errorMessage) { %><div class="alert alert--error alert--compact" role="alert"><p><%= errorMessage %></p></div><% } %>
          <% if (user) { %>
            <form action="/videos/<%= videoId %>/discussions" method="post" data-discussion-form><input type="hidden" name="_csrf" value="<%= safeCsrfToken %>"><label class="field"><span class="field__label">讨论标题 <i>必填</i></span><input type="text" name="title" maxlength="120" required placeholder="用一句话说明讨论主题"></label><div class="editor editor--compact" data-markdown-editor data-preview-endpoint="/api/markdown-preview"><section class="editor__pane"><div class="editor__bar"><strong>正文</strong><span>Markdown / LaTeX</span></div><%- include('partials/math-editor') %><textarea name="body" rows="7" maxlength="5000" required placeholder="展开你的问题、观点或补充资料……" data-markdown-input></textarea></section><section class="editor__pane editor__preview-pane"><div class="editor__bar"><strong>预览</strong><span data-preview-status>等待输入</span></div><div class="markdown-body editor__preview" data-markdown-preview><p class="editor__placeholder">格式化内容会显示在这里。</p></div></section></div><div class="composer-submit"><p>发布后默认折叠显示，读者可先看标题再决定是否展开。</p><button class="button button--primary" type="submit" data-discussion-submit>发布讨论</button></div><p class="composer-status" data-discussion-status aria-live="polite"></p></form>
          <% } else { %><div class="discussion-auth-gate"><p>账号不要求邮箱或真实姓名，用来保持讨论身份和投票的一致性。</p><a class="button button--primary" href="/login?next=<%= encodeURIComponent('/videos/' + videoId) %>">登录后参与</a></div><% } %>
        </details>

        <div class="thread-toolbar"><strong><%= safeTree.length %> 个主题</strong><span>默认折叠 · 按发布时间排列</span></div>
        <div class="thread-list" id="discussion-list">
          <% if (!safeTree.length) { %><div class="discussion-empty"><h3>还没有讨论</h3><p>可以从一个画面、一段声音，或一个没有解决的问题开始。</p></div><% } %>
          <% safeTree.forEach(function(node) { %><%- include('partials/discussion-node', { node: node, depth: 0, videoId: videoId, user: user, safeCsrfToken: safeCsrfToken, discussionDate: discussionDate, plainPreview: plainPreview }) %><% }); %>
        </div>
      </section>
      <% } %>
    </main>
  </div>
  <%- include('partials/footer') %>
</body>
</html>
