<%
  const settingsAccount = typeof account !== 'undefined' && account && typeof account === 'object'
    ? account
    : (typeof currentUser !== 'undefined' && currentUser ? currentUser : {});
  const settingsCsrf = typeof csrfToken === 'string' ? csrfToken : '';
  const settingsUsername = settingsAccount.username || '';
  const settingsForm = typeof form !== 'undefined' && form && typeof form === 'object' ? form : {};
  const formChecked = function(name) { return ['1', 'true', 'on', 1, true].includes(settingsForm[name]); };
  const settingsPreferences = typeof notificationPreferences !== 'undefined' && notificationPreferences && typeof notificationPreferences === 'object'
    ? notificationPreferences
    : (typeof preferences !== 'undefined' && preferences && typeof preferences === 'object' ? preferences : {});
  const preferenceChecked = function(camelName, snakeName, shortName) {
    if (Object.prototype.hasOwnProperty.call(settingsPreferences, camelName)) return Boolean(settingsPreferences[camelName]);
    if (Object.prototype.hasOwnProperty.call(settingsPreferences, snakeName)) return Boolean(settingsPreferences[snakeName]);
    if (Object.prototype.hasOwnProperty.call(settingsPreferences, shortName)) return Boolean(settingsPreferences[shortName]);
    return true;
  };
  const replyEnabled = preferenceChecked('replyEnabled', 'reply_enabled', 'reply');
  const videoVoteEnabled = preferenceChecked('videoVoteEnabled', 'video_vote_enabled', 'videoVote');
  const systemEnabled = preferenceChecked('systemEnabled', 'system_enabled', 'system');
%>
<%- include('partials/head', { pageTitle: '账号设置｜同见', pageDescription: '管理同见账号的密码、通知偏好和删除选项。' }) %>
<body class="page page--account">
  <a class="skip-link" href="#main-content">跳到主要内容</a>
  <%- include('partials/header', { currentPath: '/account/settings' }) %>
  <div class="app-shell shell">
    <%- include('partials/sidebar', { currentPath: '/account/settings', categoryTree: typeof categoryTree !== 'undefined' ? categoryTree : [] }) %>
    <main id="main-content" class="account-main" tabindex="-1">
      <header class="account-heading"><div><p class="eyebrow"><span></span> 个人账号</p><h1>设置</h1><p>管理安全选项、你愿意接收的通知，以及账号的最终归属。</p></div></header>

      <div class="account-layout">
        <%- include('partials/account-navigation', { currentPath: '/account/settings' }) %>
        <div class="account-content account-content--settings">
          <%- include('partials/account-feedback') %>

          <section class="account-panel" aria-labelledby="password-title">
            <header class="account-panel__heading"><div><span>01</span><h2 id="password-title">修改密码</h2></div><p>保存后，其他设备上的会话将失效，当前设备保持登录。</p></header>
            <form class="account-form account-form--narrow" action="/account/settings/password" method="post">
              <input type="hidden" name="_csrf" value="<%= settingsCsrf %>">
              <label class="field"><span class="field__label">当前密码 <i>必填</i></span><input type="password" name="currentPassword" minlength="8" maxlength="128" autocomplete="current-password" required></label>
              <label class="field"><span class="field__label">新密码 <i>必填</i></span><input type="password" name="newPassword" minlength="8" maxlength="128" autocomplete="new-password" required><span class="field__hint">至少 8 个字符，请不要与其他网站共用密码</span></label>
              <label class="field"><span class="field__label">再次输入新密码 <i>必填</i></span><input type="password" name="confirmPassword" minlength="8" maxlength="128" autocomplete="new-password" required></label>
              <div class="account-form__actions"><button class="button button--primary" type="submit">更新密码</button></div>
            </form>
          </section>

          <section class="account-panel" aria-labelledby="notification-settings-title">
            <header class="account-panel__heading"><div><span>02</span><h2 id="notification-settings-title">通知偏好</h2></div><p>关闭某一类后不再产生新通知；重新开启不会补发历史消息。</p></header>
            <form class="account-form" action="/account/settings/notifications" method="post">
              <input type="hidden" name="_csrf" value="<%= settingsCsrf %>">
              <fieldset class="setting-list">
                <legend class="visually-hidden">选择要接收的通知</legend>
                <label class="setting-row"><span><strong>收到回复</strong><small>当其他人直接回复你的讨论或回复时提醒，不包含自己回复自己。</small></span><input type="checkbox" name="replyEnabled" value="1"<% if (replyEnabled) { %> checked<% } %>><i aria-hidden="true"></i></label>
                <label class="setting-row"><span><strong>稿件获得认同或反对</strong><small>只告诉你反馈方向，不显示投票者身份；未读的同类反馈会聚合。</small></span><input type="checkbox" name="videoVoteEnabled" value="1"<% if (videoVoteEnabled) { %> checked<% } %>><i aria-hidden="true"></i></label>
                <label class="setting-row"><span><strong>系统通知</strong><small>为今后的稿件审核、规则变更等消息预留；当前没有 CMS 发送端。</small></span><input type="checkbox" name="systemEnabled" value="1"<% if (systemEnabled) { %> checked<% } %>><i aria-hidden="true"></i></label>
              </fieldset>
              <div class="account-form__actions"><button class="button button--primary" type="submit">保存通知偏好</button></div>
            </form>

            <div class="browser-notification" data-browser-notification-settings>
              <span class="browser-notification__icon" aria-hidden="true">◇</span>
              <div><strong>浏览器通知</strong><p>在同见页面打开期间，将新消息交给操作系统显示。这不会在关闭网页后继续推送。</p><small data-browser-notification-status>正在检查浏览器能力……</small></div>
              <button class="button button--quiet" type="button" data-browser-notification-button>启用浏览器通知</button>
            </div>
            <noscript><p class="secure-context-note">浏览器通知需要 JavaScript，通知页中的站内消息不受影响。</p></noscript>
          </section>

          <section class="account-panel account-panel--danger" aria-labelledby="delete-account-title">
            <header class="account-panel__heading"><div><span>03</span><h2 id="delete-account-title">删除账号</h2></div><p>删除账号不可恢复。你的用户名将永久保留，防止他人冒名使用。</p></header>
            <details class="account-delete-disclosure">
              <summary>展开删除账号选项</summary>
              <div class="account-delete-disclosure__body">
                <div class="alert alert--error alert--compact" role="note"><span class="alert__icon" aria-hidden="true">!</span><p>头像、简介、偏好、通知和你投出的票会删除，全部会话会立即失效。</p></div>
                <form class="account-form" action="/account/delete" method="post" data-typed-confirmation data-confirm-value="<%= settingsUsername %>" data-confirm-message="这是最后一次确认：账号删除后无法恢复。">
                  <input type="hidden" name="_csrf" value="<%= settingsCsrf %>">
                  <fieldset class="deletion-options"><legend>选择如何处理你的公开内容</legend>
                    <label><input type="checkbox" name="deleteVideos" value="1"<% if (formChecked('deleteVideos')) { %> checked<% } %>><span><strong>永久删除我的稿件</strong><small>清除视频、封面和作品元数据；他人的已有讨论转为存档。</small></span></label>
                    <label><input type="checkbox" name="deleteDiscussions" value="1"<% if (formChecked('deleteDiscussions')) { %> checked<% } %>><span><strong>删除我的讨论</strong><small>无回复的内容移除；有回复的内容只保留匿名墓碑以维持对话结构。</small></span></label>
                  </fieldset>
                  <p class="deletion-default">两项都不选时，稿件和讨论继续公开：发布账号和讨论作者显示为“已注销用户”，作品的创作者许可署名按原样保留。</p>
                  <label class="field"><span class="field__label">当前密码 <i>必填</i></span><input type="password" name="currentPassword" minlength="8" maxlength="128" autocomplete="current-password" required></label>
                  <label class="field"><span class="field__label">输入完整用户名 <i>必填</i></span><input type="text" name="username" value="<%= settingsForm.username || '' %>" autocomplete="off" autocapitalize="none" spellcheck="false" data-confirmation-input required><span class="field__hint">请输入 <strong><%= settingsUsername %></strong></span></label>
                  <label class="irreversible-check"><input type="checkbox" name="confirmDeletion" value="1" data-confirmation-check required><span>我理解账号和选中的内容将无法恢复。</span></label>
                  <button class="button button--danger" type="submit" data-danger-submit>永久删除账号</button>
                  <p data-confirmation-status aria-live="polite"></p>
                </form>
              </div>
            </details>
          </section>
        </div>
      </div>
    </main>
  </div>
  <%- include('partials/footer') %>
</body>
</html>
