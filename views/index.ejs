<%
  const safeFilters = typeof filters !== 'undefined' && filters ? filters : { query: '', categorySlug: '', tagSlug: '' };
  const activeListingPath = safeFilters.categorySlug
    ? '/categories/' + safeFilters.categorySlug
    : safeFilters.tagSlug ? '/tags/' + safeFilters.tagSlug : '/';
  const safeListingTitle = typeof listingTitle === 'string' ? listingTitle : '最近发布';
%>
<%- include('partials/head', {
  pageTitle: safeListingTitle + '｜同见',
  pageDescription: '发现采用开放许可的横屏长视频，在清晰授权下观看、使用和讨论。'
}) %>
<body class="page page--catalog">
  <a class="skip-link" href="#main-content">跳到主要内容</a>
  <%- include('partials/header', { currentPath: activeListingPath, filters: safeFilters }) %>

  <div class="app-shell shell">
    <%- include('partials/sidebar', { currentPath: activeListingPath, categoryTree: categoryTree }) %>
    <main id="main-content" class="catalog-main" tabindex="-1">
      <header class="catalog-header">
        <div>
          <p class="eyebrow"><span></span> 开放影像目录</p>
          <h1><%= safeListingTitle %></h1>
          <% if (safeFilters.query) { %><p>在标题、作者、作品说明和标签中搜索。</p><% } %>
        </div>
        <a class="button button--primary catalog-header__publish" href="/upload">发布视频 <span aria-hidden="true">＋</span></a>
      </header>

      <nav class="feed-tabs" aria-label="视频排序">
        <a href="/"<% if (!safeFilters.query && !safeFilters.categorySlug && !safeFilters.tagSlug) { %> aria-current="page"<% } %>>最新发布</a>
        <a href="/algorithm">排序如何工作</a>
      </nav>

      <form class="catalog-filters" action="/search" method="get">
        <label><span>搜索</span><input type="search" name="q" maxlength="120" value="<%= safeFilters.query %>" placeholder="标题、作者或标签"></label>
        <label><span>分类</span><select name="category"><option value="">全部分类</option><% categories.filter(function(category) { return category.parentId; }).forEach(function(category) { %><option value="<%= category.slug %>"<% if (safeFilters.categorySlug === category.slug) { %> selected<% } %>><%= category.parentName %> · <%= category.name %></option><% }); %></select></label>
        <button class="button button--quiet" type="submit">筛选</button>
        <% if (safeFilters.query || safeFilters.categorySlug || safeFilters.tagSlug) { %><a class="catalog-filters__clear" href="/">清除条件</a><% } %>
      </form>

      <% if (!Array.isArray(videos) || videos.length === 0) { %>
        <div class="empty-state empty-state--catalog">
          <div class="empty-state__signal" aria-hidden="true"><span></span></div>
          <p class="eyebrow"><span></span><%= safeFilters.query || safeFilters.categorySlug || safeFilters.tagSlug ? '没有匹配的作品' : '放映室已就绪' %></p>
          <h2><%= safeFilters.query || safeFilters.categorySlug || safeFilters.tagSlug ? '换一个条件再看看。' : '第一束光，等你点亮。' %></h2>
          <p><%= safeFilters.query || safeFilters.categorySlug || safeFilters.tagSlug ? '可以尝试更短的关键词，或返回全部视频。' : '这里还没有视频。发布第一段采用开放许可的横屏长视频，让它成为共同记忆的开始。' %></p>
          <a class="button button--primary" href="<%= safeFilters.query || safeFilters.categorySlug || safeFilters.tagSlug ? '/' : '/upload' %>"><%= safeFilters.query || safeFilters.categorySlug || safeFilters.tagSlug ? '查看全部视频' : '发布第一个视频' %></a>
        </div>
      <% } else { %>
        <div class="catalog-summary"><strong><%= videos.length %></strong> 段公开影像</div>
        <div class="catalog-grid">
          <% videos.forEach(function(video) {
            const created = video.createdAt ? new Date(video.createdAt) : null;
            const date = created && !Number.isNaN(created.getTime())
              ? new Intl.DateTimeFormat('zh-CN', { month: 'short', day: 'numeric' }).format(created)
              : '';
            const duration = Number(video.durationSeconds);
            const durationText = Number.isFinite(duration)
              ? (duration >= 3600
                ? Math.floor(duration / 3600) + ':' + String(Math.floor((duration % 3600) / 60)).padStart(2, '0') + ':' + String(Math.floor(duration % 60)).padStart(2, '0')
                : Math.floor(duration / 60) + ':' + String(Math.floor(duration % 60)).padStart(2, '0'))
              : '';
          %>
            <article class="catalog-card">
              <a class="catalog-card__cover" href="/videos/<%= video.id %>" aria-label="观看《<%= video.title %>》">
                <% if (video.coverStorageName) { %><img src="/videos/<%= video.id %>/cover" alt="" loading="lazy"><% } else { %><span class="catalog-card__placeholder" aria-hidden="true"><i></i><i></i><b>同见</b></span><% } %>
                <span class="catalog-card__play" aria-hidden="true">▶</span>
                <% if (durationText) { %><span class="catalog-card__duration"><%= durationText %></span><% } %>
              </a>
              <div class="catalog-card__body">
                <div class="catalog-card__context">
                  <% if (video.categoryName) { %><a href="/categories/<%= video.categorySlug %>"><%= video.categoryName %></a><% } else { %><span>未分类</span><% } %>
                  <% if (date) { %><time datetime="<%= video.createdAt %>"><%= date %></time><% } %>
                </div>
                <h2><a href="/videos/<%= video.id %>"><%= video.title %></a></h2>
                <p class="catalog-card__creator"><%= video.creator %><% if (video.accountDisplayName) { %> · 由 <%= video.accountDisplayName %> 发布<% } %></p>
                <% if (video.tags.length) { %><div class="tag-row"><% video.tags.slice(0, 4).forEach(function(tag) { %><a href="/tags/<%= tag.slug %>">#<%= tag.name %></a><% }); %></div><% } %>
                <div class="catalog-card__signals"><span>认同 <strong><%= video.upvoteCount %></strong></span><span>反对 <strong><%= video.downvoteCount %></strong></span><span><%= video.licenseLabel %></span></div>
              </div>
            </article>
          <% }); %>
        </div>
      <% } %>
    </main>
  </div>

  <%- include('partials/footer') %>
</body>
</html>
