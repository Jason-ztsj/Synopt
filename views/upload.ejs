<%
  const safeForm = typeof form !== 'undefined' && form && typeof form === 'object' ? form : {};
  const hasSubmittedValues = Object.keys(safeForm).length > 0;
  const truthyCheckbox = function(value) {
    return value === true || value === 'true' || value === 'on' || value === '1' || value === 1;
  };
  const attributionChecked = hasSubmittedValues ? truthyCheckbox(safeForm.attribution) : true;
  const nonCommercialChecked = attributionChecked && truthyCheckbox(safeForm.nonCommercial);
  const noDerivativesChecked = attributionChecked && truthyCheckbox(safeForm.noDerivatives);
  const initialLicense = !attributionChecked
    ? {
        code: 'CC0 1.0',
        name: 'CC0 1.0 通用（公共领域贡献）',
        description: '你在法律允许的范围内尽可能放弃版权及相关权利。任何人都可以复制、修改、传播和使用，无需署名。',
        note: '同见仍会展示创作者名称，但作品使用者无需署名。',
        url: 'https://creativecommons.org/publicdomain/zero/1.0/deed.zh-hans'
      }
    : nonCommercialChecked && noDerivativesChecked
      ? {
          code: 'CC BY-NC-ND 4.0',
          name: '知识共享 署名—非商业性使用—禁止演绎 4.0',
          description: '他人可以复制和传播原作，但必须标明创作者，不得用于商业目的，也不得修改作品。',
          note: '只允许非商业地原样分享，并须保留署名。',
          url: 'https://creativecommons.org/licenses/by-nc-nd/4.0/deed.zh-hans'
        }
      : nonCommercialChecked
        ? {
            code: 'CC BY-NC 4.0',
            name: '知识共享 署名—非商业性使用 4.0',
            description: '他人可以复制、传播和修改作品，但必须标明创作者，且不得用于商业目的。',
            note: '允许再创作，不允许商业使用。',
            url: 'https://creativecommons.org/licenses/by-nc/4.0/deed.zh-hans'
          }
        : noDerivativesChecked
          ? {
              code: 'CC BY-ND 4.0',
              name: '知识共享 署名—禁止演绎 4.0',
              description: '他人可以复制和传播原作，包括用于商业目的，但必须标明创作者且不得修改作品。',
              note: '允许商业使用，但只可原样分享。',
              url: 'https://creativecommons.org/licenses/by-nd/4.0/deed.zh-hans'
            }
          : {
              code: 'CC BY 4.0',
              name: '知识共享 署名 4.0 国际许可协议',
              description: '他人可以复制、传播、修改并将作品用于商业用途，但必须标明创作者。',
              note: '发布后，请在使用作品时保留创作者署名。',
              url: 'https://creativecommons.org/licenses/by/4.0/deed.zh-hans'
            };
  const safeError = typeof error !== 'undefined' ? error : null;
  const errorMessage = typeof safeError === 'string' ? safeError : (safeError && safeError.message ? safeError.message : '');
  const uploadUser = typeof currentUser !== 'undefined' && currentUser && typeof currentUser === 'object' ? currentUser : null;
  const uploadDisplayName = uploadUser ? (uploadUser.displayName || uploadUser.display_name || uploadUser.username || '用户') : '';
  const uploadUsername = uploadUser ? (uploadUser.username || '') : '';
  const uploadAvatar = Array.from(String(uploadDisplayName))[0] || '用';
  const safeCsrfToken = typeof csrfToken === 'string' ? csrfToken : '';
%>
<%- include('partials/head', {
  pageTitle: '发布视频｜同见',
  pageDescription: '向同见发布采用开放许可的视频；浏览器会在上传前检查并规范化媒体。',
  includeMediaUpload: true
}) %>
<body class="page page--upload">
  <a class="skip-link" href="#main-content">跳到主要内容</a>
  <%- include('partials/header', { currentPath: '/upload' }) %>
  <div class="app-shell shell">
  <%- include('partials/sidebar', { currentPath: '/upload', categoryTree: categoryTree }) %>
  <main id="main-content" class="upload-layout" tabindex="-1">
    <header class="page-intro">
      <a class="back-link" href="/"><span aria-hidden="true">←</span> 返回放映室</a>
      <p class="eyebrow"><span></span> 发布开放影像</p>
      <h1>把你的画面，<br><em>交给更远的目光。</em></h1>
      <p>填写作品信息、选择开放许可并上传视频。浏览器会先识别容器和编码，必要时仅做无损重封装，不会重新编码画面或声音。</p>
    </header>

    <% if (errorMessage) { %>
      <div class="alert alert--error" role="alert">
        <span class="alert__icon" aria-hidden="true">!</span>
        <div><strong>暂时无法发布</strong><p><%= errorMessage %></p></div>
      </div>
    <% } %>

    <form class="upload-form" action="/videos" method="post" enctype="multipart/form-data" data-upload-form data-max-upload-bytes="<%= Math.floor((typeof maxUploadMb !== 'undefined' ? maxUploadMb : 1024) * 1024 * 1024) %>">
      <input type="hidden" name="_csrf" value="<%= safeCsrfToken %>">
      <% if (uploadUser) { %>
        <div class="signed-in-note" role="status">
          <span class="signed-in-note__avatar" aria-hidden="true"><%= uploadAvatar %></span>
          <p>将以 <strong><%= uploadDisplayName %></strong><% if (uploadUsername && uploadUsername !== uploadDisplayName) { %> <span>@<%= uploadUsername %></span><% } %> 的账号发布。下方“创作者署名”仍由你单独填写。</p>
        </div>
      <% } %>
      <noscript>
        <div class="alert alert--notice" role="status">
          <span class="alert__icon" aria-hidden="true">i</span>
          <div><strong>许可证预览需要 JavaScript</strong><p>关闭脚本时，勾选项不会即时更新下方预览；最终规则不变：取消“署名”即按 CC0 1.0 发布，并忽略“非商业”和“禁止演绎”。</p></div>
        </div>
      </noscript>
      <section class="form-section" aria-labelledby="work-info-title">
        <div class="form-section__heading">
          <span class="step-number">01</span>
          <div><h2 id="work-info-title">作品信息</h2><p>让观看者知道这是谁的作品，以及它讲述什么。</p></div>
        </div>
        <div class="field-grid">
          <label class="field field--wide">
            <span class="field__label">视频标题 <i>必填</i></span>
            <input type="text" name="title" value="<%= safeForm.title || '' %>" maxlength="120" autocomplete="off" placeholder="例如：河流经过我们的村庄" required>
            <span class="field__hint">最多 120 个字符</span>
          </label>
          <label class="field">
            <span class="field__label">主分类 <i>必填</i></span>
            <select name="category" required>
              <option value="">请选择一个分类</option>
              <% categories.filter(function(category) { return category.parentId; }).forEach(function(category) { %>
                <option value="<%= category.slug %>"<% if (safeForm.category === category.slug) { %> selected<% } %>><%= category.parentName %> · <%= category.name %></option>
              <% }); %>
              <option value="other"<% if (safeForm.category === 'other') { %> selected<% } %>>其他</option>
            </select>
            <span class="field__hint">分类由平台维护，便于长期整理和后台管理</span>
          </label>
          <label class="field">
            <span class="field__label">标签 <small>选填</small></span>
            <input type="text" name="tags" value="<%= safeForm.tags || '' %>" maxlength="280" placeholder="例如：开源, 数学, 纪录片">
            <span class="field__hint">使用逗号分隔，最多 8 个标签，每个不超过 32 个字符</span>
          </label>
          <label class="field">
            <span class="field__label">创作者署名 <i>必填</i></span>
            <input type="text" name="creator" value="<%= safeForm.creator || '' %>" maxlength="80" autocomplete="name" placeholder="个人姓名或团体名称" required>
            <span class="field__hint">这是许可所需的作品署名，可以与你的账号显示名不同；CC0 作品也会展示</span>
          </label>
          <label class="field field--wide">
            <span class="field__label">作品描述 <small>选填</small></span>
            <textarea name="description" maxlength="2000" rows="5" placeholder="说说拍摄背景、内容或你希望观众留意的细节……"><%= safeForm.description || '' %></textarea>
            <span class="field__hint">纯文本，最多 2,000 个字符</span>
          </label>
        </div>
      </section>

      <section class="form-section" aria-labelledby="license-title" data-license-picker>
        <div class="form-section__heading">
          <span class="step-number">02</span>
          <div><h2 id="license-title">开放许可</h2><p>许可决定他人怎样使用作品。你仍然保有作品的版权。</p></div>
        </div>

        <fieldset class="license-options">
          <legend class="visually-hidden">选择知识共享许可条件</legend>
          <label class="check-card check-card--primary">
            <input type="checkbox" name="attribution"<% if (attributionChecked) { %> checked<% } %>>
            <span class="check-card__control" aria-hidden="true"></span>
            <span class="check-card__copy"><strong>署名</strong><small>使用者必须标明创作者</small></span>
            <span class="check-card__code">BY</span>
          </label>
          <div class="license-options__secondary">
            <label class="check-card">
              <input type="checkbox" name="nonCommercial"<% if (nonCommercialChecked) { %> checked<% } %><% if (!attributionChecked) { %> disabled<% } %>>
              <span class="check-card__control" aria-hidden="true"></span>
              <span class="check-card__copy"><strong>非商业</strong><small>不得用于商业目的</small></span>
              <span class="check-card__code">NC</span>
            </label>
            <label class="check-card">
              <input type="checkbox" name="noDerivatives"<% if (noDerivativesChecked) { %> checked<% } %><% if (!attributionChecked) { %> disabled<% } %>>
              <span class="check-card__control" aria-hidden="true"></span>
              <span class="check-card__copy"><strong>禁止演绎</strong><small>不得修改或再创作</small></span>
              <span class="check-card__code">ND</span>
            </label>
          </div>
        </fieldset>

        <div class="license-preview" data-license-preview aria-live="polite">
          <div class="license-preview__topline">
            <span>你选择的许可</span>
            <strong data-license-code><%= initialLicense.code %></strong>
          </div>
          <h3 data-license-name><%= initialLicense.name %></h3>
          <p data-license-description><%= initialLicense.description %></p>
          <p class="license-preview__note" data-license-note><%= initialLicense.note %></p>
          <a href="<%= initialLicense.url %>" data-license-link target="_blank" rel="license noopener">阅读官方许可文本 <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section class="form-section" aria-labelledby="video-file-title">
        <div class="form-section__heading">
          <span class="step-number">03</span>
          <div><h2 id="video-file-title">视频文件</h2><p>支持 MP4、MOV、MKV 与 WebM；首期只保留一条视频轨和至多一条音频轨。</p></div>
        </div>
        <label class="file-drop" data-file-drop>
          <input type="file" name="video" accept="video/mp4,video/quicktime,video/webm,video/x-matroska,.mp4,.m4v,.mov,.mkv,.webm" required data-file-input>
          <span class="file-drop__icon" aria-hidden="true">↑</span>
          <span class="file-drop__copy">
            <strong data-file-title>选择一个视频文件</strong>
            <small data-file-detail>点击浏览文件 · 最大 <%= typeof maxUploadMb !== 'undefined' ? maxUploadMb : 1024 %> MiB</small>
          </span>
          <span class="file-drop__action">选择文件</span>
        </label>
        <div class="media-analysis" data-media-analysis data-state="working" hidden role="status" aria-live="polite">
          <span class="media-analysis__signal" aria-hidden="true"></span>
          <div><strong data-media-analysis-title>正在分析媒体</strong><p data-media-analysis-detail></p></div>
        </div>
        <div class="format-note">
          <span aria-hidden="true">i</span>
          <p><strong>首期兼容范围</strong>H.264 + AAC 会规范为 MP4；VP9/AV1 + Opus 会规范为 WebM。HEVC + AAC 可实验性发布，但目前只在原生支持 HEVC 的设备上播放。其他编码会给出转换提示。</p>
        </div>
        <label class="cover-upload">
          <span class="cover-upload__copy"><strong>自定义封面 <small>选填</small></strong><span>严格 16:9，1280×720 至 3840×2160，JPEG / PNG / WebP，不超过 5 MiB。</span></span>
          <input type="file" name="cover" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp">
          <span class="button button--quiet">选择图片</span>
        </label>
        <p class="cover-fallback-note">不上传封面时，视频通过验证后会自动抽取第一帧，并生成 1280×720 的横屏封面。</p>
      </section>

      <div class="form-submit">
        <p>点击发布即表示你有权按所选许可分享此作品。</p>
        <button class="button button--primary button--large" type="submit" data-submit-button>确认并发布 <span aria-hidden="true">→</span></button>
        <p class="submit-status" data-upload-status aria-live="polite"></p>
      </div>
    </form>
  </main>
  </div>

  <%- include('partials/footer') %>
</body>
</html>
