<%
  const resolvedStatus = typeof status !== 'undefined'
    ? status
    : (typeof locals !== 'undefined' && locals.statusCode ? locals.statusCode : 500);
  const errorTitle = typeof title === 'string' ? title : (resolvedStatus === 404 ? '这里没有这段影像' : '放映暂时中断');
  const errorMessage = typeof message === 'string' ? message : (resolvedStatus === 404 ? '链接可能已经失效，或者地址有一点偏差。' : '服务暂时无法完成这个请求，请稍后再试。');
%>
<%- include('partials/head', {
  pageTitle: errorTitle + '｜共映',
  pageDescription: errorMessage
}) %>
<body class="page page--error">
  <a class="skip-link" href="#main-content">跳到主要内容</a>
  <%- include('partials/header', { currentPath: '' }) %>

  <main id="main-content" class="shell error-page" tabindex="-1">
    <div class="error-page__signal" aria-hidden="true"><span></span><span></span><span></span></div>
    <p class="error-page__code">ERROR / <%= resolvedStatus %></p>
    <h1><%= errorTitle %></h1>
    <p><%= errorMessage %></p>
    <div class="error-page__actions">
      <a class="button button--primary" href="/">返回共映首页</a>
      <a class="text-link" href="/upload">发布新视频 <span aria-hidden="true">→</span></a>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
