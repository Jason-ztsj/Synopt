<%
  const cmsDiscussion = typeof discussion !== 'undefined' && discussion && typeof discussion === 'object' ? discussion : {};
  const cmsDiscussionContext = typeof contextDiscussions !== 'undefined' && Array.isArray(contextDiscussions) ? contextDiscussions : (typeof context !== 'undefined' && Array.isArray(context) ? context : (typeof thread !== 'undefined' && Array.isArray(thread) ? thread : (Array.isArray(cmsDiscussion.context) ? cmsDiscussion.context : [cmsDiscussion])));
  const cmsDiscussionCases = typeof cases !== 'undefined' && Array.isArray(cases) ? cases : (Array.isArray(cmsDiscussion.cases) ? cmsDiscussion.cases : []);
  const cmsDiscussionActions = typeof actions !== 'undefined' && Array.isArray(actions) ? actions : (Array.isArray(cmsDiscussion.actions) ? cmsDiscussion.actions : []);
  const cmsDiscussionCsrf = typeof csrfToken === 'string' ? csrfToken : '';
  const cmsDiscussionVersion = Number(cmsDiscussion.moderationVersion ?? cmsDiscussion.moderation_version ?? 0) || 0;
  const cmsDiscussionDeleted = Boolean(cmsDiscussion.deletedAt || cmsDiscussion.deleted_at);
  const cmsDiscussionModeration = cmsDiscussion.moderationStatus || cmsDiscussion.moderation_status || 'visible';
  const cmsDiscussionOpenCases = cmsDiscussionCases.filter(function(item) { return item.status !== 'resolved'; });
  const cmsDiscussionActorId = typeof currentUser !== 'undefined' ? currentUser?.id : null;
  const cmsDiscussionIsAdministrator = typeof currentUser !== 'undefined' && currentUser?.role === 'administrator';
  const cmsDiscussionSelfInterest = Boolean(cmsDiscussionActorId) && String(cmsDiscussion.userId || cmsDiscussion.user_id || '') === String(cmsDiscussionActorId);
  const cmsDiscussionActionableCases = cmsDiscussionCases.filter(function(item) {
    return !cmsDiscussionSelfInterest && item.status === 'in_review' && Boolean(cmsDiscussionActorId)
      && String(item.assigneeUserId || item.assignee_user_id || '') === String(cmsDiscussionActorId);
  });
  const cmsDiscussionDate = function(value) { const date = value ? new Date(value) : null; return date && !Number.isNaN(date.getTime()) ? new Intl.DateTimeFormat('zh-CN', { dateStyle: 'medium', timeStyle: 'short' }).format(date) : '—'; };
  const cmsDiscussionLabel = cmsDiscussionDeleted ? '作者已删除' : (({ visible: '可见', hidden: '正在审核', removed: '规则移除' })[cmsDiscussionModeration] || cmsDiscussionModeration);
%>
<%- include('../partials/page-start', { pageTitle: '讨论 #' + (cmsDiscussion.id || '') + '｜同见管理后台', currentPath: '/cms/discussions/' + (cmsDiscussion.id || '') }) %>
  <nav class="cms-breadcrumb" aria-label="面包屑"><a href="/cms/discussions">讨论</a><span aria-hidden="true">/</span><span aria-current="page">#<%= cmsDiscussion.id || '—' %></span></nav>
  <header class="cms-page-heading cms-page-heading--detail"><div><p class="cms-eyebrow"><%= cmsDiscussion.parentId || cmsDiscussion.parent_id ? '回复' : '讨论主题' %></p><h1><%= cmsDiscussionDeleted ? '作者已删除的讨论墓碑' : (cmsDiscussion.title || '无标题讨论') %></h1><p>位于《<a href="/cms/videos/<%= cmsDiscussion.videoId || cmsDiscussion.video_id %>"><%= cmsDiscussion.videoTitle || cmsDiscussion.video_title || cmsDiscussion.videoId || cmsDiscussion.video_id || '未知视频' %></a>》</p></div><div class="cms-heading-status"><span class="cms-status cms-status--<%= cmsDiscussionDeleted ? 'deleted' : cmsDiscussionModeration %>"><%= cmsDiscussionLabel %></span><strong>版本 <%= cmsDiscussionVersion %></strong></div></header>
  <%- include('../partials/feedback') %>
  <div class="cms-detail-grid"><div class="cms-detail-main">
    <section class="cms-panel" aria-labelledby="discussion-content-title"><header class="cms-panel__heading"><div><p class="cms-eyebrow">目标内容</p><h2 id="discussion-content-title">原始记录</h2></div><% if (!cmsDiscussionDeleted) { %><a href="/videos/<%= cmsDiscussion.videoId || cmsDiscussion.video_id %>#discussion-<%= cmsDiscussion.id %>">尝试打开公开位置</a><% } %></header>
      <% if (cmsDiscussionDeleted) { %><div class="cms-media-placeholder"><strong>正文已由作者删除</strong><p>作者删除会清除正文和身份，只保留维持回复树所需的墓碑；CMS 不可恢复。</p></div><% } else { %>
        <article class="cms-discussion-record"><header><span class="cms-avatar" aria-hidden="true"><%= Array.from(String(cmsDiscussion.accountDisplayName || cmsDiscussion.owner_display_name || cmsDiscussion.nickname || '用'))[0] || '用' %></span><div><strong><%= cmsDiscussion.accountDisplayName || cmsDiscussion.owner_display_name || cmsDiscussion.authorDisplayName || cmsDiscussion.nickname || cmsDiscussion.accountUsername || cmsDiscussion.owner_username || '历史用户' %></strong><small><time datetime="<%= cmsDiscussion.createdAt || cmsDiscussion.created_at || '' %>"><%= cmsDiscussionDate(cmsDiscussion.createdAt || cmsDiscussion.created_at) %></time><% if (cmsDiscussion.editedAt || cmsDiscussion.edited_at) { %> · 已编辑 <%= Number(cmsDiscussion.editCount ?? cmsDiscussion.edit_count ?? 1) %> 次<% } %></small></div></header><h3><%= cmsDiscussion.title || '无标题回复' %></h3><pre class="cms-raw-content"><%= cmsDiscussion.bodyMarkdown || cmsDiscussion.body_markdown || '' %></pre></article>
      <% } %>
      <dl class="cms-definition-grid"><div><dt>讨论 ID</dt><dd><code><%= cmsDiscussion.id || '—' %></code></dd></div><div><dt>作者账号</dt><dd><% if (cmsDiscussion.userId || cmsDiscussion.user_id) { const accountLabel = cmsDiscussion.accountUsername || cmsDiscussion.owner_username || cmsDiscussion.userId || cmsDiscussion.user_id; %><% if (cmsDiscussionIsAdministrator) { %><a href="/cms/users/<%= cmsDiscussion.userId || cmsDiscussion.user_id %>"><%= accountLabel %></a><% } else { %><%= accountLabel %><% } %><% } else { %>—<% } %></dd></div><div><dt>父讨论</dt><dd><% if (cmsDiscussion.parentId || cmsDiscussion.parent_id) { %><a href="/cms/discussions/<%= cmsDiscussion.parentId || cmsDiscussion.parent_id %>">#<%= cmsDiscussion.parentId || cmsDiscussion.parent_id %></a><% } else { %>无（主题）<% } %></dd></div><div><dt>票数</dt><dd>认同 <%= Number(cmsDiscussion.upvoteCount ?? cmsDiscussion.upvote_count ?? 0) %> · 反对 <%= Number(cmsDiscussion.downvoteCount ?? cmsDiscussion.downvote_count ?? 0) %></dd></div></dl>
    </section>

    <section class="cms-panel" aria-labelledby="discussion-context-title"><header class="cms-panel__heading"><div><p class="cms-eyebrow">完整上下文</p><h2 id="discussion-context-title">回复树</h2></div><p><%= cmsDiscussionContext.length %> 条记录</p></header>
      <% if (!cmsDiscussionContext.length) { %><div class="cms-empty"><p>没有可展示的上下文。</p></div><% } else { %><ol class="cms-context-tree"><% cmsDiscussionContext.forEach(function(item) { const itemDeleted = Boolean(item.deletedAt || item.deleted_at); const itemRedacted = Boolean(item.governanceConflictRedacted); const itemModeration = item.moderationStatus || item.moderation_status || 'visible'; const depth = Math.min(6, Math.max(0, Number(item.depth ?? 0) || 0)); const itemOwn = Boolean(cmsDiscussionActorId) && String(item.userId || item.user_id || '') === String(cmsDiscussionActorId); %><li style="--context-depth:<%= depth %>"<% if (String(item.id) === String(cmsDiscussion.id)) { %> class="is-target"<% } %>><header><% if (itemRedacted) { %><strong>#<%= item.id %> · 利益冲突内容已隔离</strong><% } else if (itemOwn) { %><strong>#<%= item.id %> · 本人内容回避</strong><% } else { %><a href="/cms/discussions/<%= item.id %>">#<%= item.id %> · <%= itemDeleted ? '已删除' : (item.accountDisplayName || item.nickname || '历史用户') %></a><% } %><span class="cms-status cms-status--<%= itemDeleted ? 'deleted' : itemModeration %>"><%= itemRedacted ? '不可查看' : (itemDeleted ? '作者已删除' : (({ visible: '可见', hidden: '正在审核', removed: '规则移除' })[itemModeration] || itemModeration)) %></span></header><p><%= itemRedacted ? '该节点保留回复树位置，但正文、作者和治理状态已因利益冲突遮蔽。' : (itemDeleted ? '匿名墓碑' : (item.bodyMarkdown || item.body_markdown || '')) %></p></li><% }); %></ol><% } %>
    </section>

    <section class="cms-panel" aria-labelledby="discussion-cases-title"><header class="cms-panel__heading"><div><p class="cms-eyebrow">治理上下文</p><h2 id="discussion-cases-title">关联案件</h2></div></header><% if (!cmsDiscussionCases.length) { %><div class="cms-empty"><p>没有关联案件。</p></div><% } else { %><ul class="cms-link-list"><% cmsDiscussionCases.forEach(function(item) { %><li><a href="/cms/cases/<%= item.id %>">案件 #<%= item.id %></a><span><%= item.status || '未知状态' %> · <%= item.reportCategoryLabel || item.reportCategory || '主动调查' %></span></li><% }); %></ul><% } %></section>
    <section class="cms-panel" aria-labelledby="discussion-history-title"><header class="cms-panel__heading"><div><p class="cms-eyebrow">只追加记录</p><h2 id="discussion-history-title">治理历史</h2></div></header><% if (!cmsDiscussionActions.length) { %><div class="cms-empty"><p>尚无治理动作。</p></div><% } else { %><ol class="cms-timeline"><% cmsDiscussionActions.forEach(function(action) { %><li><div><strong><%= action.actionLabel || action.actionType || action.action %></strong><time datetime="<%= action.createdAt || action.created_at || '' %>"><%= cmsDiscussionDate(action.createdAt || action.created_at) %></time></div><p><%= action.publicReason || action.public_reason || '未提供公开说明' %></p><small><%= action.actorName || action.actorDisplayName || action.actorUsername || '系统' %></small></li><% }); %></ol><% } %></section>
  </div>
  <aside class="cms-detail-side" aria-label="讨论治理操作"><section class="cms-panel cms-panel--sticky" aria-labelledby="discussion-actions-title"><header class="cms-panel__heading"><div><h2 id="discussion-actions-title">治理动作</h2></div></header>
    <% if (!cmsDiscussionSelfInterest && !cmsDiscussionDeleted && !cmsDiscussionOpenCases.length) { %><details class="cms-disclosure"><summary>建立主动调查案件</summary><form class="cms-form" action="/cms/cases/investigations" method="post"><input type="hidden" name="_csrf" value="<%= cmsDiscussionCsrf %>"><input type="hidden" name="discussionId" value="<%= cmsDiscussion.id %>"><input type="hidden" name="reasonCategory" value="other"><label class="cms-field"><span>调查理由 <em>必填</em></span><textarea name="description" minlength="20" maxlength="2000" rows="3" required></textarea></label><button class="cms-button cms-button--primary cms-button--block" type="submit">建立案件</button></form></details><% } %>
    <% if (cmsDiscussionDeleted) { %><div class="cms-sensitive-notice"><strong>作者删除不可逆</strong><p>CMS 不提供恢复入口，也不能用治理状态覆盖作者墓碑。</p></div><% } else if (cmsDiscussionSelfInterest) { %><div class="cms-sensitive-notice"><strong>本人内容回避</strong><p>你不能建立或处理涉及本人讨论的案件；请交由其他工作人员处理。</p></div><% } else if (!cmsDiscussionActionableCases.length) { %><div class="cms-sensitive-notice"><strong>需要负责中的案件</strong><p><%= cmsDiscussionOpenCases.length ? '请先在关联案件页认领案件；只有当前负责人可以审核目标。' : '请先建立主动调查案件，再到案件页认领。' %></p></div><% } else { %>
      <form class="cms-form cms-action-form" action="/cms/discussions/<%= cmsDiscussion.id %>/<%= cmsDiscussionModeration === 'visible' ? 'hide' : 'restore' %>" method="post" data-confirm-message="确定<%= cmsDiscussionModeration === 'visible' ? '隐藏' : '恢复' %>这条讨论吗？"><input type="hidden" name="_csrf" value="<%= cmsDiscussionCsrf %>"><input type="hidden" name="expectedVersion" value="<%= cmsDiscussionVersion %>"><label class="cms-field"><span>关联案件 <em>必填</em></span><select name="caseId" required><option value="">请选择由你负责的案件</option><% cmsDiscussionActionableCases.forEach(function(item) { %><option value="<%= item.id %>">#<%= item.id %></option><% }); %></select></label><label class="cms-field"><span>公开说明 <em>必填</em></span><textarea name="publicReason" minlength="20" maxlength="2000" rows="4" required></textarea></label><label class="cms-field"><span>内部备注 <em>必填</em></span><textarea name="internalNote" minlength="5" maxlength="2000" rows="3" required></textarea></label><button class="cms-button <%= cmsDiscussionModeration === 'visible' ? 'cms-button--warning' : 'cms-button--primary' %> cms-button--block" type="submit"><%= cmsDiscussionModeration === 'visible' ? '显示正在审核占位' : '恢复原正文' %></button></form>
      <% if (cmsDiscussionModeration !== 'removed') { %><details class="cms-disclosure cms-disclosure--danger"><summary>按规则移除</summary><form class="cms-form" action="/cms/discussions/<%= cmsDiscussion.id %>/remove" method="post" data-confirm-message="确定按平台规则移除这条讨论吗？正文会保留在 CMS 供申诉。"><input type="hidden" name="_csrf" value="<%= cmsDiscussionCsrf %>"><input type="hidden" name="expectedVersion" value="<%= cmsDiscussionVersion %>"><label class="cms-field"><span>关联案件 <em>必填</em></span><select name="caseId" required><option value="">请选择由你负责的案件</option><% cmsDiscussionActionableCases.forEach(function(item) { %><option value="<%= item.id %>">#<%= item.id %></option><% }); %></select></label><label class="cms-field"><span>公开说明 <em>必填</em></span><textarea name="publicReason" minlength="20" maxlength="2000" rows="4" required></textarea></label><label class="cms-field"><span>内部备注 <em>必填</em></span><textarea name="internalNote" minlength="5" maxlength="2000" rows="3" required></textarea></label><button class="cms-button cms-button--danger cms-button--block" type="submit">确认移除</button></form></details><% } %>
    <% } %>
  </section></aside></div>
<%- include('../partials/page-end') %>
