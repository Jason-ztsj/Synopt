<%
  const cmsDiscussions = typeof discussions !== 'undefined' && Array.isArray(discussions) ? discussions : [];
  const cmsDiscussionFilters = typeof filters !== 'undefined' && filters && typeof filters === 'object' ? filters : {};
  const cmsDiscussionDate = function(value) { const date = value ? new Date(value) : null; return date && !Number.isNaN(date.getTime()) ? new Intl.DateTimeFormat('zh-CN', { dateStyle: 'medium', timeStyle: 'short' }).format(date) : '—'; };
  const cmsDiscussionModeration = function(value) { return ({ visible: '可见', hidden: '正在审核', removed: '规则移除' })[value] || value || '可见'; };
  const cmsDiscussionPreview = function(value) { return String(value || '').replace(/[`*_>#\[\]$]/g, '').replace(/\s+/g, ' ').trim().slice(0, 140) || '—'; };
%>
<%- include('../partials/page-start', { pageTitle: '讨论｜同见管理后台', currentPath: '/cms/discussions' }) %>
  <header class="cms-page-heading"><div><p class="cms-eyebrow">对话治理</p><h1>讨论</h1><p>审核时保留完整上下文和回复树。作者主动删除与平台治理是两种不可互换的状态。</p></div></header>
  <%- include('../partials/feedback') %>
  <form class="cms-filter-bar" action="/cms/discussions" method="get" aria-label="筛选讨论">
    <label><span>治理状态</span><select name="moderationStatus"><option value="">全部</option><option value="visible"<% if ((cmsDiscussionFilters.moderationStatus || cmsDiscussionFilters.moderation) === 'visible') { %> selected<% } %>>可见</option><option value="hidden"<% if ((cmsDiscussionFilters.moderationStatus || cmsDiscussionFilters.moderation) === 'hidden') { %> selected<% } %>>正在审核</option><option value="removed"<% if ((cmsDiscussionFilters.moderationStatus || cmsDiscussionFilters.moderation) === 'removed') { %> selected<% } %>>规则移除</option></select></label>
    <label><span>内容类型</span><select name="kind"><option value="">全部</option><option value="topic"<% if (cmsDiscussionFilters.kind === 'topic') { %> selected<% } %>>主题</option><option value="reply"<% if (cmsDiscussionFilters.kind === 'reply') { %> selected<% } %>>回复</option><option value="author_deleted"<% if (cmsDiscussionFilters.kind === 'author_deleted') { %> selected<% } %>>作者已删除</option></select></label>
    <label class="cms-filter-bar__search"><span>关键词</span><input type="search" name="q" maxlength="120" value="<%= cmsDiscussionFilters.q || '' %>" placeholder="正文、标题、作者或 ID"></label>
    <button class="cms-button cms-button--primary" type="submit">筛选</button><a class="cms-button cms-button--quiet" href="/cms/discussions">清除</a>
  </form>
  <section class="cms-panel" aria-labelledby="discussion-list-title"><header class="cms-panel__heading"><div><h2 id="discussion-list-title">讨论记录</h2><p><%= typeof pagination !== 'undefined' && pagination?.total !== undefined ? Number(pagination.total) : cmsDiscussions.length %> 个结果</p></div></header>
  <% if (!cmsDiscussions.length) { %><div class="cms-empty"><h3>没有符合条件的讨论</h3><p>调整筛选条件后再试。</p></div><% } else { %><div class="cms-table-wrap"><table class="cms-table"><caption class="cms-visually-hidden">讨论记录</caption><thead><tr><th scope="col">讨论</th><th scope="col">所在视频</th><th scope="col">作者</th><th scope="col">治理状态</th><th scope="col">回复</th><th scope="col">发布时间</th><th scope="col"><span class="cms-visually-hidden">操作</span></th></tr></thead><tbody>
  <% cmsDiscussions.forEach(function(item) { const deleted = Boolean(item.deletedAt || item.deleted_at); const moderation = item.moderationStatus || item.moderation_status || 'visible'; const body = item.bodyMarkdown || item.body_markdown || ''; const own = typeof currentUser !== 'undefined' && String(item.userId || item.user_id || '') === String(currentUser?.id || ''); %><tr><td data-label="讨论"><% if (own) { %><strong><%= deleted ? '作者已删除的墓碑' : (item.title || cmsDiscussionPreview(body)) %></strong><% } else { %><a href="/cms/discussions/<%= item.id %>"><%= deleted ? '作者已删除的墓碑' : (item.title || cmsDiscussionPreview(body)) %></a><% } %><small class="cms-cell-note">#<%= item.id %> · <%= item.parentId || item.parent_id ? '回复' : '主题' %><% if (own) { %> · 本人内容<% } %></small></td><td data-label="所在视频"><a href="/cms/videos/<%= item.videoId || item.video_id %>"><%= item.videoTitle || item.video_title || item.videoId || item.video_id %></a></td><td data-label="作者"><%= deleted ? '已清除' : (item.accountDisplayName || item.owner_display_name || item.authorDisplayName || item.nickname || item.accountUsername || item.owner_username || '历史用户') %></td><td data-label="治理状态"><% if (deleted) { %><span class="cms-status cms-status--deleted">作者已删除</span><% } else { %><span class="cms-status cms-status--<%= moderation %>"><%= cmsDiscussionModeration(moderation) %></span><% } %></td><td data-label="回复"><%= Number(item.replyCount ?? item.reply_count ?? 0) %></td><td data-label="发布时间"><time datetime="<%= item.createdAt || item.created_at || '' %>"><%= cmsDiscussionDate(item.createdAt || item.created_at) %></time></td><td data-label="操作"><% if (own) { %><span class="cms-muted">本人内容 · 回避</span><% } else { %><a class="cms-row-link" href="/cms/discussions/<%= item.id %>">查看上下文</a><% } %></td></tr><% }); %>
  </tbody></table></div><% } %></section>
  <%- include('../partials/pagination', { basePath: '/cms/discussions', queryString: typeof paginationQuery === 'string' ? paginationQuery : '' }) %>
<%- include('../partials/page-end') %>
