<%
  const cmsAppeals = (typeof appeals !== 'undefined' && Array.isArray(appeals) ? appeals : []).map(function(item) {
    return {
      ...item,
      actionId: item.actionId || item.action_id || item.moderationActionId || item.moderation_action_id,
      actionType: item.actionType || item.action_type || item.action,
      targetType: item.targetType || item.target_type || (item.videoId || item.video_id ? 'video' : (item.discussionId || item.discussion_id ? 'discussion' : 'user')),
      targetId: item.targetId || item.target_id || item.videoId || item.video_id || item.discussionId || item.discussion_id || item.targetUserId || item.target_user_id
    };
  });
  const cmsAppealFilters = typeof filters !== 'undefined' && filters && typeof filters === 'object' ? filters : {};
  const cmsAppealDate = function(value) { const date = value ? new Date(value) : null; return date && !Number.isNaN(date.getTime()) ? new Intl.DateTimeFormat('zh-CN', { dateStyle: 'medium', timeStyle: 'short' }).format(date) : '—'; };
  const cmsAppealStatus = function(value) { return ({ pending: '待复核', in_review: '复核中', resolved: '已结案', upheld: '维持决定', overturned: '撤销决定' })[value] || value || '待复核'; };
%>
<%- include('../partials/page-start', { pageTitle: '申诉｜同见管理后台', currentPath: '/cms/appeals' }) %>
  <header class="cms-page-heading"><div><p class="cms-eyebrow">独立复核</p><h1>申诉</h1><p>优先由非原操作者复核。撤销决定时仍需通过目标当前版本检查，不能覆盖后续治理动作。</p></div></header>
  <%- include('../partials/feedback') %>
  <form class="cms-filter-bar" action="/cms/appeals" method="get" aria-label="筛选申诉"><label><span>状态</span><select name="status"><option value="">全部</option><option value="pending"<% if (cmsAppealFilters.status === 'pending') { %> selected<% } %>>待复核</option><option value="in_review"<% if (cmsAppealFilters.status === 'in_review') { %> selected<% } %>>复核中</option><option value="resolved"<% if (cmsAppealFilters.status === 'resolved') { %> selected<% } %>>已结案</option></select></label><label><span>目标</span><select name="target"><option value="">全部</option><option value="video"<% if (cmsAppealFilters.target === 'video') { %> selected<% } %>>视频</option><option value="discussion"<% if (cmsAppealFilters.target === 'discussion') { %> selected<% } %>>讨论</option><option value="user"<% if (cmsAppealFilters.target === 'user') { %> selected<% } %>>账号</option></select></label><label><span>分配</span><select name="assignment"><option value="">全部</option><option value="unassigned"<% if (cmsAppealFilters.assignment === 'unassigned') { %> selected<% } %>>未认领</option><option value="mine"<% if (cmsAppealFilters.assignment === 'mine') { %> selected<% } %>>由我复核</option></select></label><label class="cms-filter-bar__search"><span>关键词</span><input type="search" name="q" maxlength="120" value="<%= cmsAppealFilters.q || '' %>" placeholder="申诉号、动作号、作者或对象 ID"></label><button class="cms-button cms-button--primary" type="submit">筛选</button><a class="cms-button cms-button--quiet" href="/cms/appeals">清除</a></form>
  <section class="cms-panel" aria-labelledby="appeal-list-title"><header class="cms-panel__heading"><div><h2 id="appeal-list-title">申诉列表</h2><p><%= typeof pagination !== 'undefined' && pagination?.total !== undefined ? Number(pagination.total) : cmsAppeals.length %> 个结果</p></div></header>
    <% if (!cmsAppeals.length) { %><div class="cms-empty"><h3>没有符合条件的申诉</h3><p>当前队列为空，或筛选范围内没有结果。</p></div><% } else { %><div class="cms-table-wrap"><table class="cms-table"><caption class="cms-visually-hidden">申诉列表</caption><thead><tr><th scope="col">申诉</th><th scope="col">状态</th><th scope="col">原决定</th><th scope="col">目标</th><th scope="col">申诉人</th><th scope="col">复核人</th><th scope="col">提交时间</th><th scope="col"><span class="cms-visually-hidden">操作</span></th></tr></thead><tbody><% cmsAppeals.forEach(function(item) { const targetType = item.targetType || item.target_type || item.actionTargetType || item.action_target_type || 'content'; %><tr><td data-label="申诉"><a href="/cms/appeals/<%= item.id %>">#<%= item.id %></a><small class="cms-cell-note">动作 #<%= item.actionId || item.action_id || '—' %></small></td><td data-label="状态"><span class="cms-status cms-status--<%= item.status || item.outcome || 'pending' %>"><%= cmsAppealStatus(item.outcome || item.status) %></span></td><td data-label="原决定"><%= item.actionLabel || item.actionType || item.action_type || '治理决定' %></td><td data-label="目标"><span class="cms-kind"><%= targetType %></span><%= item.targetTitle || item.targetId || item.target_id || '—' %></td><td data-label="申诉人"><%= item.appellantDisplayName || item.appellantUsername || item.userUsername || '受影响账号' %></td><td data-label="复核人"><%= item.reviewerDisplayName || item.reviewerUsername || '未认领' %></td><td data-label="提交时间"><time datetime="<%= item.createdAt || item.created_at || '' %>"><%= cmsAppealDate(item.createdAt || item.created_at) %></time></td><td data-label="操作"><a class="cms-row-link" href="/cms/appeals/<%= item.id %>">复核</a></td></tr><% }); %></tbody></table></div><% } %>
  </section>
  <%- include('../partials/pagination', { basePath: '/cms/appeals', queryString: typeof paginationQuery === 'string' ? paginationQuery : '' }) %>
<%- include('../partials/page-end') %>
