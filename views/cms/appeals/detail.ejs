<%
  const cmsAppeal = typeof appeal !== 'undefined' && appeal && typeof appeal === 'object' ? appeal : {};
  const cmsAppealAction = typeof moderationAction !== 'undefined' && moderationAction && typeof moderationAction === 'object'
    ? moderationAction
    : (typeof originalAction !== 'undefined' && originalAction && typeof originalAction === 'object'
      ? originalAction
      : (cmsAppeal.action && typeof cmsAppeal.action === 'object' ? cmsAppeal.action : {}));
  const cmsAppealTarget = typeof target !== 'undefined' && target && typeof target === 'object' ? target : (cmsAppeal.target && typeof cmsAppeal.target === 'object' ? cmsAppeal.target : {});
  const cmsAppealCsrf = typeof csrfToken === 'string' ? csrfToken : '';
  const cmsAppealVersion = Number(cmsAppeal.version ?? cmsAppeal.appealVersion ?? cmsAppeal.appeal_version ?? 0) || 0;
  const cmsAppealExpectedTargetVersion = Number(cmsAppealAction.afterVersion ?? cmsAppealAction.after_version ?? cmsAppeal.expectedTargetVersion ?? 0) || 0;
  const cmsAppealStatus = cmsAppeal.status || 'pending';
  const cmsAppealOutcome = cmsAppeal.outcome || cmsAppeal.result || '';
  const cmsAppealActorId = typeof currentUser !== 'undefined' ? currentUser?.id : null;
  const cmsAppealReviewerId = cmsAppeal.reviewerUserId || cmsAppeal.reviewer_user_id || null;
  const cmsAppealIsReviewer = Boolean(cmsAppealActorId) && String(cmsAppealReviewerId || '') === String(cmsAppealActorId);
  const cmsAppealIsAdministrator = typeof currentUser !== 'undefined' && currentUser?.role === 'administrator';
  const cmsAppealStaff = typeof staff !== 'undefined' && Array.isArray(staff) ? staff : [];
  const cmsAppealReviewConflict = typeof reviewConflict !== 'undefined' ? Boolean(reviewConflict) : Boolean(cmsAppeal.reviewConflict);
  const cmsAppealSelfInterest = typeof selfInterestConflict !== 'undefined' ? Boolean(selfInterestConflict) : Boolean(cmsAppeal.selfInterestConflict);
  const cmsAppealUniqueAdmin = typeof uniqueAdministratorException !== 'undefined' ? Boolean(uniqueAdministratorException) : Boolean(cmsAppeal.uniqueAdministratorException);
  const cmsAppealStateConflict = typeof stateConflict !== 'undefined' ? Boolean(stateConflict) : Boolean(cmsAppeal.stateConflict);
  const cmsAppealDate = function(value) { const date = value ? new Date(value) : null; return date && !Number.isNaN(date.getTime()) ? new Intl.DateTimeFormat('zh-CN', { dateStyle: 'medium', timeStyle: 'short' }).format(date) : '—'; };
  const cmsAppealStatusLabel = ({ pending: '待复核', in_review: '复核中', resolved: '已结案' })[cmsAppealStatus] || cmsAppealStatus;
  const cmsAppealOutcomeLabel = ({ upheld: '维持决定', overturned: '撤销决定' })[cmsAppealOutcome] || cmsAppealOutcome;
  const cmsAppealTargetType = cmsAppealAction.targetType || cmsAppealAction.target_type || cmsAppeal.targetType || cmsAppeal.target_type || 'content';
  const cmsAppealTargetId = cmsAppealAction.targetId || cmsAppealAction.target_id || cmsAppeal.targetId || cmsAppeal.target_id || cmsAppealTarget.id || '';
  const cmsAppealTargetStatus = cmsAppealTarget.moderationStatus || cmsAppealTarget.moderation_status || cmsAppealTarget.status || '';
  const cmsAppealBeforeStatus = cmsAppealAction.before?.moderationStatus || cmsAppealAction.before?.status || '';
  const cmsAppealCurrentTargetVersion = Number(cmsAppealTarget.moderationVersion ?? cmsAppealTarget.moderation_version ?? cmsAppealTarget.governanceVersion ?? cmsAppealTarget.governance_version ?? 0) || 0;
  const cmsAppealTargetUnavailableForRestore = Boolean(cmsAppealTarget.deletedAt || cmsAppealTarget.deleted_at)
    || cmsAppealTargetStatus === 'disabled';
  const cmsAppealConflictStatuses = [cmsAppealTargetStatus, ...(cmsAppealTargetUnavailableForRestore ? [] : [cmsAppealBeforeStatus])]
    .filter(function(value, index, values) { return Boolean(value) && values.indexOf(value) === index; });
  const cmsAppealStatusName = function(value) { return ({ visible: '恢复原内容', hidden: '保持隐藏', removed: '保持移除', active: '恢复账号', suspended: '保持暂停' })[value] || value; };
  const cmsAppealAccountOnly = cmsAppealAction.action === 'user_suspend';
  const cmsAppealTransferStaff = cmsAppealStaff.filter(function(person) {
    return person.status === 'active'
      && (!cmsAppealAccountOnly || person.role === 'administrator')
      && String(person.id) !== String(cmsAppealReviewerId || '')
      && String(person.id) !== String(cmsAppeal.appellantUserId || cmsAppeal.appellant_user_id || '')
      && String(person.id) !== String(cmsAppeal.actionCaseReporterUserId || cmsAppeal.action_case_reporter_user_id || '')
      && (
        String(person.id) !== String(cmsAppealAction.actorUserId || cmsAppealAction.actor_user_id || '')
        || (cmsAppealUniqueAdmin && String(person.id) === String(cmsAppealActorId || ''))
      );
  });
  const cmsAppealWindow = Number(typeof appealWindowDays !== 'undefined' ? appealWindowDays : 0) || 0;
  const cmsAppealActionDate = cmsAppealAction.createdAt || cmsAppealAction.created_at;
  const cmsAppealDeadline = cmsAppealActionDate && cmsAppealWindow
    ? new Date(Date.parse(cmsAppealActionDate) + cmsAppealWindow * 24 * 60 * 60 * 1000).toISOString()
    : (cmsAppeal.deadlineAt || cmsAppeal.deadline_at || '');
%>
<%- include('../partials/page-start', { pageTitle: '申诉 #' + (cmsAppeal.id || '') + '｜同见管理后台', currentPath: '/cms/appeals/' + (cmsAppeal.id || '') }) %>
  <nav class="cms-breadcrumb" aria-label="面包屑"><a href="/cms/appeals">申诉</a><span aria-hidden="true">/</span><span aria-current="page">#<%= cmsAppeal.id || '—' %></span></nav>
  <header class="cms-page-heading cms-page-heading--detail"><div><p class="cms-eyebrow">治理决定复核</p><h1>申诉 #<%= cmsAppeal.id || '—' %></h1><p>针对动作 #<%= cmsAppealAction.id || cmsAppeal.actionId || cmsAppeal.action_id || '—' %> · 提交于 <%= cmsAppealDate(cmsAppeal.createdAt || cmsAppeal.created_at) %></p></div><div class="cms-heading-status"><span class="cms-status cms-status--<%= cmsAppealOutcome || cmsAppealStatus %>"><%= cmsAppealOutcomeLabel || cmsAppealStatusLabel %></span></div></header>
  <%- include('../partials/feedback') %>
  <% if (cmsAppealReviewConflict) { %><div class="cms-alert cms-alert--warning" role="alert"><strong><%= cmsAppealSelfInterest ? '利益冲突：不能复核自己的申诉' : '原操作者回避' %></strong><p><%= cmsAppealSelfInterest ? '请交由另一名合格工作人员认领和复核；唯一管理员例外不适用于本人申诉。' : (cmsAppealUniqueAdmin ? '当前只剩一名有效管理员，因此允许例外复核本人决定；提交时会写入冲突审计。' : '你是原决定操作者，应由另一名工作人员完成复核。') %></p></div><% } %>
  <% if (cmsAppealStateConflict) { %><div class="cms-alert cms-alert--error" role="alert"><strong>目标状态已经发生后续变化</strong><p><%= cmsAppealTargetUnavailableForRestore ? '目标已由作者删除或账号已终止；人工处理只能保留当前状态，不能伪造恢复。' : '撤销操作未覆盖后续治理动作。申诉保持复核中，负责人必须明确选择恢复原状态或保留当前状态。' %></p></div><% } %>
  <div class="cms-detail-grid"><div class="cms-detail-main">
    <section class="cms-panel" aria-labelledby="appeal-reason-title"><header class="cms-panel__heading"><div><p class="cms-eyebrow">申诉人陈述</p><h2 id="appeal-reason-title">申诉理由</h2></div></header><div class="cms-prose"><p><%= cmsAppeal.reason || cmsAppeal.body || '未提供申诉理由' %></p></div><dl class="cms-definition-grid"><div><dt>申诉人</dt><dd><%= cmsAppeal.appellantDisplayName || cmsAppeal.appellantUsername || cmsAppeal.userUsername || '受影响账号' %></dd></div><div><dt>提交时间</dt><dd><%= cmsAppealDate(cmsAppeal.createdAt || cmsAppeal.created_at) %></dd></div><div><dt>窗口截止</dt><dd><%= cmsAppealDate(cmsAppealDeadline) %></dd></div><div><dt>复核人</dt><dd><%= cmsAppeal.reviewerDisplayName || cmsAppeal.reviewerName || cmsAppeal.reviewerUsername || '未认领' %></dd></div></dl></section>
    <section class="cms-panel" aria-labelledby="appeal-action-title"><header class="cms-panel__heading"><div><p class="cms-eyebrow">原治理动作</p><h2 id="appeal-action-title"><%= cmsAppealAction.actionLabel || cmsAppealAction.actionType || cmsAppealAction.action_type || cmsAppealAction.action || '治理决定' %></h2></div><% if (cmsAppealAction.caseId || cmsAppealAction.case_id) { %><a href="/cms/cases/<%= cmsAppealAction.caseId || cmsAppealAction.case_id %>">案件 #<%= cmsAppealAction.caseId || cmsAppealAction.case_id %></a><% } %></header><dl class="cms-definition-grid"><div><dt>目标</dt><dd><a href="/cms/<%= cmsAppealTargetType === 'user' ? 'users' : (cmsAppealTargetType === 'discussion' ? 'discussions' : 'videos') %>/<%= cmsAppealTargetId %>"><%= cmsAppealTarget.title || cmsAppealTarget.username || cmsAppeal.targetTitle || cmsAppealTargetId || '查看目标' %></a></dd></div><div><dt>原操作者</dt><dd><%= cmsAppealAction.actorName || cmsAppealAction.actorDisplayName || cmsAppealAction.actorUsername || '工作人员' %></dd></div><div><dt>动作时间</dt><dd><%= cmsAppealDate(cmsAppealAction.createdAt || cmsAppealAction.created_at) %></dd></div><div><dt>动作后版本</dt><dd><%= cmsAppealExpectedTargetVersion %></dd></div><div class="cms-definition-grid__wide"><dt>公开说明</dt><dd><%= cmsAppealAction.publicReason || cmsAppealAction.public_reason || '未提供公开说明' %></dd></div><div class="cms-definition-grid__wide"><dt>内部备注</dt><dd><%= cmsAppealAction.internalNote || cmsAppealAction.internal_note || '—' %></dd></div></dl></section>
    <section class="cms-panel" aria-labelledby="appeal-target-title"><header class="cms-panel__heading"><div><p class="cms-eyebrow">当前事实</p><h2 id="appeal-target-title">目标当前状态</h2></div></header><dl class="cms-definition-grid"><div><dt>对象 ID</dt><dd><code><%= cmsAppealTargetId || '—' %></code></dd></div><div><dt>当前治理状态</dt><dd><%= cmsAppealTarget.moderationStatus || cmsAppealTarget.moderation_status || cmsAppealTarget.status || '—' %></dd></div><div><dt>当前版本</dt><dd><%= cmsAppealTarget.moderationVersion ?? cmsAppealTarget.moderation_version ?? cmsAppealTarget.governanceVersion ?? cmsAppealTarget.governance_version ?? '—' %></dd></div><div><dt>原动作预期版本</dt><dd><%= cmsAppealExpectedTargetVersion %></dd></div></dl></section>
    <% if (cmsAppealOutcome) { %><section class="cms-panel" aria-labelledby="appeal-result-title"><header class="cms-panel__heading"><div><p class="cms-eyebrow">复核结果</p><h2 id="appeal-result-title"><%= cmsAppealOutcomeLabel %></h2></div></header><div class="cms-prose"><p><%= cmsAppeal.publicExplanation || cmsAppeal.public_explanation || '未提供公开说明' %></p></div><dl class="cms-definition-grid"><div><dt>复核人</dt><dd><%= cmsAppeal.reviewerDisplayName || cmsAppeal.reviewerName || cmsAppeal.reviewerUsername || '工作人员' %></dd></div><div><dt>完成时间</dt><dd><%= cmsAppealDate(cmsAppeal.resolvedAt || cmsAppeal.resolved_at) %></dd></div></dl></section><% } %>
  </div>
  <aside class="cms-detail-side" aria-label="申诉复核操作"><section class="cms-panel cms-panel--sticky" aria-labelledby="appeal-controls-title"><header class="cms-panel__heading"><div><h2 id="appeal-controls-title">复核决定</h2><p>申诉版本 <%= cmsAppealVersion %></p></div></header>
    <% if (cmsAppealStatus === 'pending') { %><form class="cms-form cms-action-form" action="/cms/appeals/<%= cmsAppeal.id %>/claim" method="post"><input type="hidden" name="_csrf" value="<%= cmsAppealCsrf %>"><input type="hidden" name="expectedVersion" value="<%= cmsAppealVersion %>"><label class="cms-field"><span>认领理由 <em>必填</em></span><textarea name="internalReason" minlength="5" maxlength="500" rows="2" required></textarea></label><button class="cms-button cms-button--primary cms-button--block" type="submit"<% if (cmsAppealReviewConflict && !cmsAppealUniqueAdmin) { %> disabled aria-disabled="true"<% } %>>认领复核</button></form>
    <% } %>
    <% if (cmsAppealStatus === 'in_review' && (cmsAppealIsReviewer || cmsAppealIsAdministrator) && cmsAppealTransferStaff.length) { %><details class="cms-disclosure"><summary>转交申诉</summary><form class="cms-form" action="/cms/appeals/<%= cmsAppeal.id %>/transfer" method="post"><input type="hidden" name="_csrf" value="<%= cmsAppealCsrf %>"><input type="hidden" name="expectedVersion" value="<%= cmsAppealVersion %>"><label class="cms-field"><span>转交给 <em>必填</em></span><select name="assigneeUserId" required><option value="">请选择合格工作人员</option><% cmsAppealTransferStaff.forEach(function(person) { %><option value="<%= person.id %>"><%= person.displayName || person.username || person.id %></option><% }); %></select></label><label class="cms-field"><span>转交理由 <em>必填</em></span><textarea name="internalReason" minlength="5" maxlength="1000" rows="2" required></textarea></label><button class="cms-button cms-button--quiet cms-button--block" type="submit">确认转交</button></form></details><% } %>
    <% if (cmsAppealStatus === 'in_review' && cmsAppealIsReviewer && !cmsAppealOutcome && cmsAppealStateConflict) { %><details class="cms-disclosure"><summary>维持原决定并结案</summary><form class="cms-form" action="/cms/appeals/<%= cmsAppeal.id %>/review" method="post" data-confirm-message="确定维持原决定并结束这项申诉吗？"><input type="hidden" name="_csrf" value="<%= cmsAppealCsrf %>"><input type="hidden" name="expectedVersion" value="<%= cmsAppealVersion %>"><input type="hidden" name="result" value="upheld"><label class="cms-field"><span>公开说明 <em>必填</em></span><textarea name="publicExplanation" minlength="20" maxlength="2000" rows="4" required></textarea></label><label class="cms-field"><span>内部复核备注 <em>必填</em></span><textarea name="internalNote" minlength="5" maxlength="2000" rows="3" required></textarea></label><button class="cms-button cms-button--warning cms-button--block" type="submit"<% if (cmsAppealReviewConflict && !cmsAppealUniqueAdmin) { %> disabled aria-disabled="true"<% } %>>维持原决定</button></form></details><form class="cms-form cms-action-form" action="/cms/appeals/<%= cmsAppeal.id %>/resolve-conflict" method="post" data-confirm-message="确定以所选目标状态人工解决冲突并撤销原决定吗？"><input type="hidden" name="_csrf" value="<%= cmsAppealCsrf %>"><input type="hidden" name="expectedVersion" value="<%= cmsAppealVersion %>"><input type="hidden" name="expectedTargetVersion" value="<%= cmsAppealCurrentTargetVersion %>"><fieldset class="cms-choice-group"><legend>撤销决定后的目标处理 <em>必填</em></legend><% cmsAppealConflictStatuses.forEach(function(status) { const restoresOriginal = status === cmsAppealBeforeStatus; %><label><input type="radio" name="targetStatus" value="<%= status %>" required><span><strong><%= restoresOriginal ? '恢复原动作前状态' : '保留当前后续状态' %></strong><small><%= cmsAppealStatusName(status) %> (<%= status %>)</small></span></label><% }); %></fieldset><label class="cms-field"><span>公开说明 <em>必填</em></span><textarea name="publicExplanation" minlength="20" maxlength="2000" rows="5" required></textarea></label><label class="cms-field"><span>内部冲突处理备注 <em>必填</em></span><textarea name="internalNote" minlength="5" maxlength="2000" rows="3" required></textarea></label><button class="cms-button cms-button--danger cms-button--block" type="submit"<% if (cmsAppealReviewConflict && !cmsAppealUniqueAdmin) { %> disabled aria-disabled="true"<% } %>>撤销并人工解决冲突</button></form>
    <% } else if (cmsAppealStatus === 'in_review' && cmsAppealIsReviewer && !cmsAppealOutcome) { %><form class="cms-form cms-action-form" action="/cms/appeals/<%= cmsAppeal.id %>/review" method="post" data-confirm-message="确定提交申诉复核结论吗？"><input type="hidden" name="_csrf" value="<%= cmsAppealCsrf %>"><input type="hidden" name="expectedVersion" value="<%= cmsAppealVersion %>"><fieldset class="cms-choice-group"><legend>复核结果 <em>必填</em></legend><label><input type="radio" name="result" value="upheld" required><span><strong>维持决定</strong><small>原决定与规则、证据一致</small></span></label><label><input type="radio" name="result" value="overturned" required><span><strong>撤销决定</strong><small>尝试以原动作版本执行 CAS 恢复</small></span></label></fieldset><label class="cms-field"><span>公开说明 <em>必填</em></span><textarea name="publicExplanation" minlength="20" maxlength="2000" rows="5" required></textarea></label><label class="cms-field"><span>内部复核备注 <em>必填</em></span><textarea name="internalNote" minlength="5" maxlength="2000" rows="3" required></textarea></label><button class="cms-button cms-button--danger cms-button--block" type="submit"<% if (cmsAppealReviewConflict && !cmsAppealUniqueAdmin) { %> disabled aria-disabled="true"<% } %>>提交复核结论</button></form>
    <% } else if (cmsAppealOutcome) { %><div class="cms-sensitive-notice"><strong>复核已完成</strong><p>结果和公开说明已经通知申诉人。</p></div><% } else if (cmsAppealStatus === 'in_review' && !cmsAppealIsReviewer) { %><div class="cms-sensitive-notice"><strong>由指定复核人处理</strong><p>只有当前认领该申诉的工作人员可以提交复核结论。</p></div><% } %>
  </section></aside></div>
<%- include('../partials/page-end') %>
