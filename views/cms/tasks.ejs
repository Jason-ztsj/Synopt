<%
  const cmsValidationTasks = typeof validationTasks !== 'undefined' && Array.isArray(validationTasks)
    ? validationTasks
    : (typeof videos !== 'undefined' && Array.isArray(videos)
      ? videos
      : (typeof tasks !== 'undefined' && Array.isArray(tasks?.videos) ? tasks.videos : []));
  const cmsDeletionTasks = typeof deletionTasks !== 'undefined' && Array.isArray(deletionTasks)
    ? deletionTasks
    : (typeof deletions !== 'undefined' && Array.isArray(deletions)
      ? deletions
      : (typeof tasks !== 'undefined' && Array.isArray(tasks?.deletions) ? tasks.deletions : []));
  const cmsTaskCsrf = typeof csrfToken === 'string' ? csrfToken : '';
  const cmsTaskViewerId = typeof currentUser !== 'undefined' ? currentUser?.id : null;
  const cmsTaskDate = function(value) { const date = value ? new Date(value) : null; return date && !Number.isNaN(date.getTime()) ? new Intl.DateTimeFormat('zh-CN', { dateStyle: 'medium', timeStyle: 'short' }).format(date) : '—'; };
  const cmsTaskValidationLabel = function(value) { return ({ pending: '等待验证', validating: '验证中', ready: '验证通过', ready_with_warnings: '通过·有警告', rejected: '验证拒绝', validation_failed: '验证服务失败' })[value] || value || '未知'; };
%>
<%- include('partials/page-start', { pageTitle: '系统任务｜同见管理后台', currentPath: '/cms/tasks' }) %>
  <header class="cms-page-heading"><div><p class="cms-eyebrow">仅管理员</p><h1>系统任务</h1><p>后台只能重新排队失败任务，不能将视频直接标记为 ready，也不能在 Web 请求中物理删除媒体文件。</p></div></header>
  <%- include('partials/feedback') %>
  <div class="cms-alert cms-alert--info" role="note"><strong>Worker 边界</strong><p>重试操作只更新任务状态并写审计；独立 validator/删除 worker 负责实际执行。</p></div>
  <section class="cms-panel" id="validation-failures" aria-labelledby="validation-task-title"><header class="cms-panel__heading"><div><p class="cms-eyebrow">媒体管线</p><h2 id="validation-task-title">视频验证状态</h2></div><p><%= cmsValidationTasks.length %> 项</p></header>
    <% if (!cmsValidationTasks.length) { %><div class="cms-empty"><p>没有需要关注的验证任务。</p></div><% } else { %><div class="cms-table-wrap"><table class="cms-table"><caption class="cms-visually-hidden">视频验证任务</caption><thead><tr><th scope="col">视频</th><th scope="col">状态</th><th scope="col">最近开始</th><th scope="col">摘要</th><th scope="col">操作</th></tr></thead><tbody><% cmsValidationTasks.forEach(function(video) { const status = video.validationStatus || video.validation_status; const own = Boolean(cmsTaskViewerId) && String(video.userId || video.user_id || '') === String(cmsTaskViewerId); const validatedAt = video.validatedAt ?? video.validated_at ?? null; const validationStartedAt = video.validationStartedAt ?? video.validation_started_at ?? null; %><tr><td data-label="视频"><% if (own) { %><strong><%= video.title || video.id %></strong><% } else { %><a href="/cms/videos/<%= video.id %>"><%= video.title || video.id %></a><% } %><small class="cms-cell-note"><code><%= video.id %></code><% if (own) { %> · 本人内容回避<% } %></small></td><td data-label="状态"><span class="cms-status cms-status--<%= status || 'unknown' %>"><%= cmsTaskValidationLabel(status) %></span></td><td data-label="最近开始"><%= cmsTaskDate(video.validationStartedAt || video.validation_started_at) %></td><td data-label="摘要"><%= video.validationSummary?.message || video.validationError || video.validation_error || '—' %></td><td data-label="操作"><% if (status === 'validation_failed') { %><form class="cms-table-form" action="/cms/tasks/videos/<%= video.id %>/retry" method="post" data-confirm-message="确定将该视频安全地重置为 pending 吗？"><input type="hidden" name="_csrf" value="<%= cmsTaskCsrf %>"><input type="hidden" name="expectedValidatedAt" value="<%= validatedAt === null ? '__null__' : validatedAt %>"><input type="hidden" name="expectedValidationStartedAt" value="<%= validationStartedAt === null ? '__null__' : validationStartedAt %>"><label><span class="cms-visually-hidden">重试理由</span><input type="text" name="internalReason" minlength="10" maxlength="500" placeholder="重试理由" required></label><button class="cms-button cms-button--warning cms-button--small" type="submit">重新排队</button></form><% } else { %><span class="cms-muted">只读</span><% } %></td></tr><% }); %></tbody></table></div><% } %>
  </section>
  <section class="cms-panel" id="deletion-failures" aria-labelledby="deletion-task-title"><header class="cms-panel__heading"><div><p class="cms-eyebrow">持久删除队列</p><h2 id="deletion-task-title">文件删除任务</h2></div><p><%= cmsDeletionTasks.length %> 项</p></header>
    <% if (!cmsDeletionTasks.length) { %><div class="cms-empty"><p>删除队列为空。</p></div><% } else { %><div class="cms-table-wrap"><table class="cms-table"><caption class="cms-visually-hidden">文件删除任务</caption><thead><tr><th scope="col">任务</th><th scope="col">类型</th><th scope="col">尝试次数</th><th scope="col">下次尝试</th><th scope="col">最近错误</th><th scope="col">操作</th></tr></thead><tbody><% cmsDeletionTasks.forEach(function(task) { const attempts = Number(task.attemptCount ?? task.attempt_count ?? 0); %><tr><td data-label="任务">#<%= task.id %><small class="cms-cell-note"><code><%= task.storageName || task.storage_name || '—' %></code></small></td><td data-label="类型"><%= ({ video: '视频', cover: '封面', avatar: '头像' })[task.kind] || task.kind || '未知' %></td><td data-label="尝试次数"><%= attempts %></td><td data-label="下次尝试"><%= cmsTaskDate(task.nextAttemptAt || task.next_attempt_at) %></td><td data-label="最近错误"><%= task.lastError || task.last_error || '—' %></td><td data-label="操作"><% if (attempts > 0) { %><form class="cms-table-form" action="/cms/tasks/deletions/<%= task.id %>/retry" method="post" data-confirm-message="确定让该删除任务立即再次进入 worker 队列吗？"><input type="hidden" name="_csrf" value="<%= cmsTaskCsrf %>"><input type="hidden" name="expectedUpdatedAt" value="<%= task.updatedAt || task.updated_at || '' %>"><label><span class="cms-visually-hidden">重试理由</span><input type="text" name="internalReason" minlength="10" maxlength="500" placeholder="重试理由" required></label><button class="cms-button cms-button--warning cms-button--small" type="submit">立即重试</button></form><% } else { %><span class="cms-muted">等待 worker</span><% } %></td></tr><% }); %></tbody></table></div><% } %>
  </section>
<%- include('partials/page-end') %>
