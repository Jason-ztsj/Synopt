<%
  const cmsVideos = typeof videos !== 'undefined' && Array.isArray(videos) ? videos : [];
  const cmsVideoFilters = typeof filters !== 'undefined' && filters && typeof filters === 'object' ? filters : {};
  const cmsVideoDate = function(value) { const date = value ? new Date(value) : null; return date && !Number.isNaN(date.getTime()) ? new Intl.DateTimeFormat('zh-CN', { dateStyle: 'medium', timeStyle: 'short' }).format(date) : '—'; };
  const cmsValidationLabel = function(value) { return ({ pending: '等待验证', validating: '验证中', ready: '验证通过', ready_with_warnings: '通过·有警告', rejected: '验证拒绝', validation_failed: '验证失败' })[value] || value || '未知'; };
  const cmsModerationLabel = function(value) { return ({ visible: '可见', hidden: '已隐藏', removed: '已移除' })[value] || value || '未知'; };
%>
<%- include('../partials/page-start', { pageTitle: '视频｜同见管理后台', currentPath: '/cms/videos' }) %>
  <header class="cms-page-heading"><div><p class="cms-eyebrow">内容治理</p><h1>视频</h1><p>同时查看技术验证、发布可见性和治理状态。CMS 不能把技术验证直接改为通过。</p></div></header>
  <%- include('../partials/feedback') %>
  <form class="cms-filter-bar" action="/cms/videos" method="get" aria-label="筛选视频">
    <label><span>技术状态</span><select name="validationStatus"><option value="">全部</option><% [['pending','等待验证'],['validating','验证中'],['ready','验证通过'],['ready_with_warnings','通过·有警告'],['rejected','验证拒绝'],['validation_failed','验证失败']].forEach(function(option) { %><option value="<%= option[0] %>"<% if ((cmsVideoFilters.validationStatus || cmsVideoFilters.validation) === option[0]) { %> selected<% } %>><%= option[1] %></option><% }); %></select></label>
    <label><span>可见性</span><select name="visibility"><option value="">全部</option><option value="public"<% if (cmsVideoFilters.visibility === 'public') { %> selected<% } %>>公开</option><option value="unlisted"<% if (cmsVideoFilters.visibility === 'unlisted') { %> selected<% } %>>不公开列出</option><option value="private"<% if (cmsVideoFilters.visibility === 'private') { %> selected<% } %>>私密</option></select></label>
    <label><span>治理状态</span><select name="moderationStatus"><option value="">全部</option><option value="visible"<% if ((cmsVideoFilters.moderationStatus || cmsVideoFilters.moderation) === 'visible') { %> selected<% } %>>可见</option><option value="hidden"<% if ((cmsVideoFilters.moderationStatus || cmsVideoFilters.moderation) === 'hidden') { %> selected<% } %>>已隐藏</option><option value="removed"<% if ((cmsVideoFilters.moderationStatus || cmsVideoFilters.moderation) === 'removed') { %> selected<% } %>>已移除</option></select></label>
    <label class="cms-filter-bar__search"><span>关键词</span><input type="search" name="q" maxlength="120" value="<%= cmsVideoFilters.q || '' %>" placeholder="标题、作者或视频 ID"></label>
    <button class="cms-button cms-button--primary" type="submit">筛选</button><a class="cms-button cms-button--quiet" href="/cms/videos">清除</a>
  </form>
  <section class="cms-panel" aria-labelledby="video-list-title"><header class="cms-panel__heading"><div><h2 id="video-list-title">视频记录</h2><p><%= typeof pagination !== 'undefined' && pagination?.total !== undefined ? Number(pagination.total) : cmsVideos.length %> 个结果</p></div></header>
  <% if (!cmsVideos.length) { %><div class="cms-empty"><h3>没有符合条件的视频</h3><p>调整筛选条件后再试。</p></div><% } else { %><div class="cms-table-wrap"><table class="cms-table"><caption class="cms-visually-hidden">视频记录</caption><thead><tr><th scope="col">视频</th><th scope="col">作者</th><th scope="col">技术状态</th><th scope="col">可见性</th><th scope="col">治理状态</th><th scope="col">发布时间</th><th scope="col"><span class="cms-visually-hidden">操作</span></th></tr></thead><tbody>
  <% cmsVideos.forEach(function(video) { const visibility = video.visibility || 'public'; const moderation = video.moderationStatus || video.moderation_status || 'visible'; const validation = video.validationStatus || video.validation_status; const own = typeof currentUser !== 'undefined' && String(video.userId || video.user_id || '') === String(currentUser?.id || ''); %><tr><td data-label="视频"><% if (own) { %><strong><%= video.title || '无标题视频' %></strong><% } else { %><a href="/cms/videos/<%= video.id %>"><%= video.title || '无标题视频' %></a><% } %><small class="cms-cell-note"><code><%= video.id %></code><% if (own) { %> · 本人内容<% } %></small></td><td data-label="作者"><%= video.accountDisplayName || video.owner_display_name || video.authorDisplayName || video.creator || video.accountUsername || video.owner_username || '已注销用户' %></td><td data-label="技术状态"><span class="cms-status cms-status--<%= validation || 'unknown' %>"><%= cmsValidationLabel(validation) %></span><% if (Number(video.validationWarningCount ?? video.validation_warning_count ?? 0) > 0) { %><small class="cms-cell-note"><%= Number(video.validationWarningCount ?? video.validation_warning_count) %> 个警告</small><% } %></td><td data-label="可见性"><%= ({ public: '公开', unlisted: '不公开列出', private: '私密' })[visibility] || visibility %><% if (video.withdrawnAt || video.withdrawn_at) { %><small class="cms-cell-note">作者已撤回</small><% } %></td><td data-label="治理状态"><span class="cms-status cms-status--<%= moderation %>"><%= cmsModerationLabel(moderation) %></span></td><td data-label="发布时间"><time datetime="<%= video.createdAt || video.created_at || '' %>"><%= cmsVideoDate(video.createdAt || video.created_at) %></time></td><td data-label="操作"><% if (own) { %><span class="cms-muted">本人内容 · 回避</span><% } else { %><a class="cms-row-link" href="/cms/videos/<%= video.id %>">查看</a><% } %></td></tr><% }); %>
  </tbody></table></div><% } %></section>
  <%- include('../partials/pagination', { basePath: '/cms/videos', queryString: typeof paginationQuery === 'string' ? paginationQuery : '' }) %>
<%- include('../partials/page-end') %>
