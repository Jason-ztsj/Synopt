<%
  const cmsVideo = typeof video !== 'undefined' && video && typeof video === 'object' ? video : {};
  const cmsVideoCases = typeof cases !== 'undefined' && Array.isArray(cases) ? cases : (Array.isArray(cmsVideo.cases) ? cmsVideo.cases : []);
  const cmsVideoActions = typeof actions !== 'undefined' && Array.isArray(actions) ? actions : (Array.isArray(cmsVideo.actions) ? cmsVideo.actions : []);
  const cmsVideoCsrf = typeof csrfToken === 'string' ? csrfToken : '';
  const cmsVideoVersion = Number(cmsVideo.moderationVersion ?? cmsVideo.moderation_version ?? 0) || 0;
  const cmsVideoModeration = cmsVideo.moderationStatus || cmsVideo.moderation_status || 'visible';
  const cmsVideoValidation = cmsVideo.validationStatus || cmsVideo.validation_status || 'unknown';
  const cmsVideoVisibility = cmsVideo.visibility || 'public';
  const cmsVideoSensitive = cmsVideoVisibility !== 'public'
    || Boolean(cmsVideo.withdrawnAt || cmsVideo.withdrawn_at)
    || cmsVideoModeration !== 'visible';
  const cmsVideoOpenCases = cmsVideoCases.filter(function(item) { return item.status !== 'resolved'; });
  const cmsVideoActorId = typeof currentUser !== 'undefined' ? currentUser?.id : null;
  const cmsVideoIsAdministrator = typeof currentUser !== 'undefined' && currentUser?.role === 'administrator';
  const cmsVideoSelfInterest = Boolean(cmsVideoActorId) && String(cmsVideo.userId || cmsVideo.user_id || '') === String(cmsVideoActorId);
  const cmsVideoActionableCases = cmsVideoCases.filter(function(item) {
    return !cmsVideoSelfInterest && item.status === 'in_review' && Boolean(cmsVideoActorId)
      && String(item.assigneeUserId || item.assignee_user_id || '') === String(cmsVideoActorId);
  });
  const cmsVideoReportReasons = typeof reportReasons !== 'undefined' && reportReasons && typeof reportReasons === 'object'
    ? Object.entries(reportReasons).map(function(entry) { return { value: entry[0], label: entry[1] }; })
    : [];
  const cmsVideoDate = function(value) { const date = value ? new Date(value) : null; return date && !Number.isNaN(date.getTime()) ? new Intl.DateTimeFormat('zh-CN', { dateStyle: 'medium', timeStyle: 'short' }).format(date) : '—'; };
  const cmsVideoValidationLabel = ({ pending: '等待验证', validating: '验证中', ready: '验证通过', ready_with_warnings: '验证通过（有警告）', rejected: '验证拒绝', validation_failed: '验证服务失败' })[cmsVideoValidation] || cmsVideoValidation;
  const cmsVideoModerationLabel = ({ visible: '可见', hidden: '已隐藏', removed: '已移除' })[cmsVideoModeration] || cmsVideoModeration;
%>
<%- include('../partials/page-start', { pageTitle: (cmsVideo.title || '视频') + '｜同见管理后台', currentPath: '/cms/videos/' + (cmsVideo.id || '') }) %>
  <nav class="cms-breadcrumb" aria-label="面包屑"><a href="/cms/videos">视频</a><span aria-hidden="true">/</span><span aria-current="page"><%= cmsVideo.title || cmsVideo.id || '详情' %></span></nav>
  <header class="cms-page-heading cms-page-heading--detail"><div><p class="cms-eyebrow">视频记录</p><h1><%= cmsVideo.title || '无标题视频' %></h1><p><code><%= cmsVideo.id || '—' %></code> · <%= cmsVideo.accountDisplayName || cmsVideo.owner_display_name || cmsVideo.creator || cmsVideo.accountUsername || cmsVideo.owner_username || '已注销用户' %></p></div><div class="cms-heading-status"><span class="cms-status cms-status--<%= cmsVideoModeration %>"><%= cmsVideoModerationLabel %></span><strong><%= cmsVideoValidationLabel %></strong></div></header>
  <%- include('../partials/feedback') %>
  <div class="cms-detail-grid"><div class="cms-detail-main">
    <section class="cms-panel" aria-labelledby="video-preview-title"><header class="cms-panel__heading"><div><p class="cms-eyebrow">必要媒体访问</p><h2 id="video-preview-title">媒体预览</h2></div></header>
      <% if (cmsVideo.deletedAt || cmsVideo.deleted_at) { %><div class="cms-media-placeholder"><strong>媒体已由作者永久删除</strong><p>CMS 不会尝试恢复或伪造已删除的文件。</p></div>
      <% } else if (cmsVideoSensitive) { %><div class="cms-media-placeholder cms-media-placeholder--sensitive"><strong>私密媒体已遮蔽</strong><p>媒体只能从关联案件页申请短时授权后查看。</p></div>
        <% if (cmsVideoSelfInterest) { %><p class="cms-expiry-note">你是该视频的发布者，不能建立、查看或处理涉及本人内容的内部案件。</p><% } else if (!cmsVideoOpenCases.length) { %><form class="cms-form cms-form--bordered" action="/cms/cases/investigations" method="post"><input type="hidden" name="_csrf" value="<%= cmsVideoCsrf %>"><input type="hidden" name="videoId" value="<%= cmsVideo.id %>"><label class="cms-field"><span>调查分类 <em>必填</em></span><select name="reasonCategory" required><option value="">请选择</option><% cmsVideoReportReasons.forEach(function(item) { const value = typeof item === 'string' ? item : (item.value || item.id || item.code); const label = typeof item === 'string' ? item : (item.label || item.name || value); %><option value="<%= value %>"><%= label %></option><% }); %><% if (!cmsVideoReportReasons.length) { %><option value="other">其他</option><% } %></select></label><label class="cms-field"><span>主动调查理由 <em>必填</em></span><textarea name="description" minlength="20" maxlength="2000" rows="3" required></textarea></label><button class="cms-button cms-button--primary" type="submit">建立主动调查案件</button></form><% } else { %><p class="cms-expiry-note">已有未结案件：<% cmsVideoOpenCases.forEach(function(item, index) { %><% if (index) { %>、<% } %><a href="/cms/cases/<%= item.id %>">#<%= item.id %></a><% }); %>。请在案件页认领后申请访问。</p><% } %>
      <% } else if (['ready','ready_with_warnings'].includes(cmsVideoValidation)) { %><div class="cms-media-frame"><video controls playsinline preload="metadata"<% if (cmsVideo.coverStorageName || cmsVideo.cover_storage_name) { %> poster="/videos/<%= cmsVideo.id %>/cover"<% } %>><source src="/videos/<%= cmsVideo.id %>/media" type="<%= cmsVideo.mediaType || cmsVideo.media_type || 'video/mp4' %>">浏览器无法播放该视频。</video></div><% if (cmsVideoSensitive) { %><p class="cms-expiry-note">当前预览依赖短时案件授权；授权过期后后续请求将被拒绝。</p><% } %>
      <% } else { %><div class="cms-media-placeholder"><strong><%= cmsVideoValidationLabel %></strong><p>技术验证未完成或未通过，CMS 不能绕过验证播放媒体。</p></div><% } %>
    </section>

    <section class="cms-panel" aria-labelledby="video-metadata-title"><header class="cms-panel__heading"><div><p class="cms-eyebrow">单一事实来源</p><h2 id="video-metadata-title">媒体与发布信息</h2></div><a href="/videos/<%= cmsVideo.id %>">尝试打开作者/公开视图</a></header>
      <dl class="cms-definition-grid"><div><dt>创作者署名</dt><dd><%= cmsVideo.creator || '—' %></dd></div><div><dt>发布账号</dt><dd><% if (cmsVideo.userId || cmsVideo.user_id) { const accountLabel = cmsVideo.accountDisplayName || cmsVideo.owner_display_name || cmsVideo.accountUsername || cmsVideo.owner_username || cmsVideo.userId || cmsVideo.user_id; %><% if (cmsVideoIsAdministrator) { %><a href="/cms/users/<%= cmsVideo.userId || cmsVideo.user_id %>"><%= accountLabel %></a><% } else { %><%= accountLabel %><% } %><% } else { %>已注销用户<% } %></dd></div><div><dt>分类</dt><dd><%= cmsVideo.categoryName || cmsVideo.category_name || '未分类' %></dd></div><div><dt>标签</dt><dd><% if (Array.isArray(cmsVideo.tags) && cmsVideo.tags.length) { cmsVideo.tags.forEach(function(tag) { %><span class="cms-tag">#<%= tag.name || tag.slug %></span><% }); } else { %>—<% } %></dd></div><div><dt>可见性</dt><dd><%= ({ public: '公开', unlisted: '不公开列出', private: '私密' })[cmsVideoVisibility] || cmsVideoVisibility %><% if (cmsVideo.withdrawnAt || cmsVideo.withdrawn_at) { %> · 作者已撤回<% } %></dd></div><div><dt>许可证</dt><dd><%= cmsVideo.licenseCode || cmsVideo.license_code || '—' %></dd></div><div class="cms-definition-grid__wide"><dt>简介</dt><dd><%= cmsVideo.description || '未填写简介' %></dd></div></dl>
    </section>

    <section class="cms-panel" aria-labelledby="video-technical-title"><header class="cms-panel__heading"><div><p class="cms-eyebrow">技术验证只读</p><h2 id="video-technical-title">验证摘要</h2></div><% if (cmsVideoIsAdministrator) { %><a href="/cms/tasks#validation-failures">查看任务</a><% } %></header>
      <dl class="cms-definition-grid"><div><dt>验证状态</dt><dd><span class="cms-status cms-status--<%= cmsVideoValidation %>"><%= cmsVideoValidationLabel %></span></dd></div><div><dt>警告数量</dt><dd><%= Number(cmsVideo.validationWarningCount ?? cmsVideo.validation_warning_count ?? 0) %></dd></div><div><dt>容器 / 编码</dt><dd><%= (cmsVideo.container || '—').toUpperCase() %> · <%= cmsVideo.videoCodec || cmsVideo.video_codec || '—' %><% if (cmsVideo.audioCodec || cmsVideo.audio_codec) { %> / <%= cmsVideo.audioCodec || cmsVideo.audio_codec %><% } %></dd></div><div><dt>尺寸</dt><dd><%= cmsVideo.width && cmsVideo.height ? cmsVideo.width + '×' + cmsVideo.height : '—' %></dd></div><div><dt>时长</dt><dd><%= cmsVideo.durationSeconds ?? cmsVideo.duration_seconds ?? '—' %><% if (cmsVideo.durationSeconds || cmsVideo.duration_seconds) { %> 秒<% } %></dd></div><div><dt>文件大小</dt><dd><%= cmsVideo.byteSize ?? cmsVideo.byte_size ?? '—' %> 字节</dd></div><div class="cms-definition-grid__wide"><dt>验证消息</dt><dd><%= cmsVideo.validationSummary?.message || cmsVideo.validation_summary?.message || cmsVideo.validationError || '没有附加消息' %></dd></div></dl>
    </section>

    <section class="cms-panel" aria-labelledby="video-cases-title"><header class="cms-panel__heading"><div><p class="cms-eyebrow">治理上下文</p><h2 id="video-cases-title">关联案件</h2></div></header><% if (!cmsVideoCases.length) { %><div class="cms-empty"><p>没有关联案件。</p></div><% } else { %><ul class="cms-link-list"><% cmsVideoCases.forEach(function(item) { %><li><a href="/cms/cases/<%= item.id %>">案件 #<%= item.id %></a><span><%= item.status || '未知状态' %> · <%= item.reportCategoryLabel || item.reportCategory || '主动调查' %></span></li><% }); %></ul><% } %></section>
    <section class="cms-panel" aria-labelledby="video-history-title"><header class="cms-panel__heading"><div><p class="cms-eyebrow">只追加记录</p><h2 id="video-history-title">治理历史</h2></div></header><% if (!cmsVideoActions.length) { %><div class="cms-empty"><p>尚无治理动作。</p></div><% } else { %><ol class="cms-timeline"><% cmsVideoActions.forEach(function(action) { %><li><div><strong><%= action.actionLabel || action.actionType || action.action %></strong><time datetime="<%= action.createdAt || action.created_at || '' %>"><%= cmsVideoDate(action.createdAt || action.created_at) %></time></div><p><%= action.publicReason || action.public_reason || '未提供公开说明' %></p><small><%= action.actorName || action.actorDisplayName || action.actorUsername || '系统' %></small></li><% }); %></ol><% } %></section>
  </div>

  <aside class="cms-detail-side" aria-label="视频治理操作"><section class="cms-panel cms-panel--sticky" aria-labelledby="video-actions-title"><header class="cms-panel__heading"><div><h2 id="video-actions-title">治理动作</h2><p>当前版本 <%= cmsVideoVersion %></p></div></header>
    <% if (!cmsVideoSelfInterest && !cmsVideoSensitive && !cmsVideoOpenCases.length && !(cmsVideo.deletedAt || cmsVideo.deleted_at)) { %><details class="cms-disclosure"><summary>建立主动调查案件</summary><form class="cms-form" action="/cms/cases/investigations" method="post"><input type="hidden" name="_csrf" value="<%= cmsVideoCsrf %>"><input type="hidden" name="videoId" value="<%= cmsVideo.id %>"><input type="hidden" name="reasonCategory" value="other"><label class="cms-field"><span>调查理由 <em>必填</em></span><textarea name="description" minlength="20" maxlength="2000" rows="3" required></textarea></label><button class="cms-button cms-button--primary cms-button--block" type="submit">建立案件</button></form></details><% } %>
    <% if (cmsVideo.deletedAt || cmsVideo.deleted_at) { %><div class="cms-sensitive-notice"><strong>作者已永久删除</strong><p>CMS 没有恢复或物理删除入口。</p></div><% } else if (cmsVideoSelfInterest) { %><div class="cms-sensitive-notice"><strong>本人内容回避</strong><p>你不能建立或处理涉及本人视频的案件；请交由其他工作人员处理。</p></div><% } else if (!cmsVideoActionableCases.length) { %><div class="cms-sensitive-notice"><strong>需要负责中的案件</strong><p><%= cmsVideoOpenCases.length ? '请先在关联案件页认领案件；只有当前负责人可以审核目标。' : '请先建立主动调查案件，再到案件页认领。' %></p></div><% } else { %>
      <form class="cms-form cms-action-form" action="/cms/videos/<%= cmsVideo.id %>/<%= cmsVideoModeration === 'visible' ? 'hide' : 'restore' %>" method="post" data-confirm-message="确定<%= cmsVideoModeration === 'visible' ? '临时隐藏' : '恢复' %>这段视频吗？"><input type="hidden" name="_csrf" value="<%= cmsVideoCsrf %>"><input type="hidden" name="expectedVersion" value="<%= cmsVideoVersion %>"><label class="cms-field"><span>关联案件 <em>必填</em></span><select name="caseId" required><option value="">请选择由你负责的案件</option><% cmsVideoActionableCases.forEach(function(item) { %><option value="<%= item.id %>">#<%= item.id %></option><% }); %></select></label><label class="cms-field"><span>公开说明 <em>必填</em></span><textarea name="publicReason" minlength="20" maxlength="2000" rows="4" required></textarea></label><label class="cms-field"><span>内部备注 <em>必填</em></span><textarea name="internalNote" minlength="5" maxlength="2000" rows="3" required></textarea></label><button class="cms-button <%= cmsVideoModeration === 'visible' ? 'cms-button--warning' : 'cms-button--primary' %> cms-button--block" type="submit"><%= cmsVideoModeration === 'visible' ? '临时隐藏' : '恢复治理可见性' %></button></form>
      <% if (cmsVideoModeration !== 'removed') { %><details class="cms-disclosure cms-disclosure--danger"><summary>确认移除视频</summary><form class="cms-form" action="/cms/videos/<%= cmsVideo.id %>/remove" method="post" data-confirm-message="确定将视频标记为已移除吗？文件会保留供申诉，公开页面将不可见。"><input type="hidden" name="_csrf" value="<%= cmsVideoCsrf %>"><input type="hidden" name="expectedVersion" value="<%= cmsVideoVersion %>"><label class="cms-field"><span>关联案件 <em>必填</em></span><select name="caseId" required><option value="">请选择由你负责的案件</option><% cmsVideoActionableCases.forEach(function(item) { %><option value="<%= item.id %>">#<%= item.id %></option><% }); %></select></label><label class="cms-field"><span>公开说明 <em>必填</em></span><textarea name="publicReason" minlength="20" maxlength="2000" rows="4" required></textarea></label><label class="cms-field"><span>内部备注 <em>必填</em></span><textarea name="internalNote" minlength="5" maxlength="2000" rows="3" required></textarea></label><button class="cms-button cms-button--danger cms-button--block" type="submit">确认移除</button></form></details><% } %>
    <% } %>
  </section></aside></div>
<%- include('../partials/page-end') %>
