<%
  const cmsAuditEvents = typeof events !== 'undefined' && Array.isArray(events) ? events : (typeof auditEvents !== 'undefined' && Array.isArray(auditEvents) ? auditEvents : []);
  const cmsAuditFilters = typeof filters !== 'undefined' && filters && typeof filters === 'object' ? filters : {};
  const cmsAuditDate = function(value) { const date = value ? new Date(value) : null; return date && !Number.isNaN(date.getTime()) ? new Intl.DateTimeFormat('zh-CN', { dateStyle: 'medium', timeStyle: 'medium' }).format(date) : '—'; };
  const cmsAuditJson = function(value) { if (value === null || value === undefined || value === '') return ''; if (typeof value === 'string') { try { return JSON.stringify(JSON.parse(value), null, 2); } catch { return value; } } try { return JSON.stringify(value, null, 2); } catch { return String(value); } };
%>
<%- include('partials/page-start', { pageTitle: '审计日志｜同见管理后台', currentPath: '/cms/audit' }) %>
  <header class="cms-page-heading"><div><p class="cms-eyebrow">仅管理员 · 只追加</p><h1>审计日志</h1><p>查询 CMS 写操作、角色变化、任务重试和敏感内容授权。后台没有删除审计事件的入口。</p></div></header>
  <%- include('partials/feedback') %>
  <form class="cms-filter-bar cms-filter-bar--audit" action="/cms/audit" method="get" aria-label="筛选审计日志"><label><span>操作者</span><input type="search" name="actor" maxlength="120" value="<%= cmsAuditFilters.actor || '' %>" placeholder="用户名或 ID"></label><label><span>动作</span><input type="search" name="action" maxlength="120" value="<%= cmsAuditFilters.action || '' %>" placeholder="例如 video.hide"></label><label><span>对象类型</span><select name="objectType"><option value="">全部</option><% [['moderation_case','案件'],['video','视频'],['discussion','讨论'],['user','账号'],['appeal','申诉'],['category','分类'],['tag','标签'],['session','会话'],['file_deletion','文件删除任务']].forEach(function(entry) { %><option value="<%= entry[0] %>"<% if (cmsAuditFilters.objectType === entry[0]) { %> selected<% } %>><%= entry[1] %></option><% }); %></select></label><label><span>对象 ID</span><input type="search" name="objectId" maxlength="120" value="<%= cmsAuditFilters.objectId || '' %>"></label><label><span>开始日期</span><input type="date" name="from" value="<%= cmsAuditFilters.from || '' %>"></label><label><span>结束日期</span><input type="date" name="to" value="<%= cmsAuditFilters.to || '' %>"></label><button class="cms-button cms-button--primary" type="submit">筛选</button><a class="cms-button cms-button--quiet" href="/cms/audit">清除</a></form>
  <section class="cms-panel" aria-labelledby="audit-list-title"><header class="cms-panel__heading"><div><h2 id="audit-list-title">事件记录</h2><p><%= typeof pagination !== 'undefined' && pagination?.total !== undefined ? Number(pagination.total) : cmsAuditEvents.length %> 个结果</p></div></header>
    <% if (!cmsAuditEvents.length) { %><div class="cms-empty"><h3>没有符合条件的事件</h3><p>调整筛选范围后再试。</p></div><% } else { %><div class="cms-table-wrap"><table class="cms-table cms-table--audit"><caption class="cms-visually-hidden">审计事件记录</caption><thead><tr><th scope="col">时间</th><th scope="col">操作者</th><th scope="col">动作</th><th scope="col">对象</th><th scope="col">请求</th><th scope="col">治理字段</th></tr></thead><tbody><% cmsAuditEvents.forEach(function(event) { const before = event.before ?? event.beforeJson ?? event.before_json; const after = event.after ?? event.afterJson ?? event.after_json; const reason = event.reason || event.metadata?.reason; %><tr><td data-label="时间"><time datetime="<%= event.createdAt || event.created_at || '' %>"><%= cmsAuditDate(event.createdAt || event.created_at) %></time></td><td data-label="操作者"><strong><%= event.actorName || event.actorDisplayName || event.actorUsername || event.actorType || event.actor_label || '系统' %></strong><small class="cms-cell-note"><%= event.actorUserId || event.actorId || event.actor_user_id || event.actor_id || '' %></small></td><td data-label="动作"><code><%= event.action || event.eventType || event.event_type || 'unknown' %></code><% if (reason) { %><small class="cms-cell-note"><%= reason %></small><% } %></td><td data-label="对象"><%= event.objectType || event.object_type || event.targetType || '—' %><small class="cms-cell-note"><code><%= event.objectId || event.object_id || event.targetId || '—' %></code></small></td><td data-label="请求"><% if (event.requestId || event.request_id) { %><code><%= event.requestId || event.request_id %></code><% } else { %>—<% } %></td><td data-label="治理字段"><% if (before || after) { %><details class="cms-json-disclosure"><summary>查看前后状态</summary><% if (before) { %><strong>操作前</strong><pre><%= cmsAuditJson(before) %></pre><% } %><% if (after) { %><strong>操作后</strong><pre><%= cmsAuditJson(after) %></pre><% } %></details><% } else { %>—<% } %></td></tr><% }); %></tbody></table></div><% } %>
  </section>
  <%- include('partials/pagination', { basePath: '/cms/audit', queryString: typeof paginationQuery === 'string' ? paginationQuery : '' }) %>
<%- include('partials/page-end') %>
