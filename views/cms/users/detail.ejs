<%
  const cmsUser = typeof user !== 'undefined' && user && typeof user === 'object' ? user : (typeof account !== 'undefined' && account ? account : {});
  const cmsUserVideos = typeof videos !== 'undefined' && Array.isArray(videos) ? videos : (Array.isArray(cmsUser.videos) ? cmsUser.videos : []);
  const cmsUserDiscussions = typeof discussions !== 'undefined' && Array.isArray(discussions) ? discussions : (Array.isArray(cmsUser.discussions) ? cmsUser.discussions : []);
  const cmsUserActions = typeof actions !== 'undefined' && Array.isArray(actions) ? actions : (Array.isArray(cmsUser.actions) ? cmsUser.actions : []);
  const cmsUserSessions = typeof sessions !== 'undefined' && Array.isArray(sessions) ? sessions : (Array.isArray(cmsUser.sessions) ? cmsUser.sessions : []);
  const cmsUserVideoTotal = Number(typeof videoTotal !== 'undefined' ? videoTotal : (cmsUser.videoCount ?? cmsUser.video_count ?? cmsUserVideos.length)) || 0;
  const cmsUserDiscussionTotal = Number(typeof discussionTotal !== 'undefined' ? discussionTotal : (cmsUser.discussionCount ?? cmsUser.discussion_count ?? cmsUserDiscussions.length)) || 0;
  const cmsUserCsrf = typeof csrfToken === 'string' ? csrfToken : '';
  const cmsUserVersion = Number(cmsUser.governanceVersion ?? cmsUser.governance_version ?? 0) || 0;
  const cmsUserSelf = typeof isSelf !== 'undefined' ? Boolean(isSelf) : (typeof currentUser !== 'undefined' && String(currentUser?.id) === String(cmsUser.id));
  const cmsUserLastAdmin = typeof isLastAdministrator !== 'undefined' ? Boolean(isLastAdministrator) : Boolean(cmsUser.isLastAdministrator);
  const cmsUserProtected = cmsUserSelf || (cmsUser.role === 'administrator' && cmsUserLastAdmin);
  const cmsUserDate = function(value) { const date = value ? new Date(value) : null; return date && !Number.isNaN(date.getTime()) ? new Intl.DateTimeFormat('zh-CN', { dateStyle: 'medium', timeStyle: 'short' }).format(date) : '—'; };
  const cmsUserRoleLabel = ({ member: '成员', moderator: '审核员', administrator: '管理员' })[cmsUser.role] || cmsUser.role || '成员';
  const cmsUserStatusLabel = ({ active: '正常', suspended: '已暂停', disabled: '已终止' })[cmsUser.status] || cmsUser.status || '未知';
%>
<%- include('../partials/page-start', { pageTitle: (cmsUser.displayName || cmsUser.username || '账号') + '｜同见管理后台', currentPath: '/cms/users/' + (cmsUser.id || '') }) %>
  <nav class="cms-breadcrumb" aria-label="面包屑"><a href="/cms/users">账号</a><span aria-hidden="true">/</span><span aria-current="page">@<%= cmsUser.username || '—' %></span></nav>
  <header class="cms-page-heading cms-page-heading--detail"><div><p class="cms-eyebrow">账号记录</p><h1><%= cmsUser.displayName || cmsUser.display_name || cmsUser.username || '未知账号' %></h1><p>@<%= cmsUser.username || '—' %> · <code><%= cmsUser.id || '—' %></code></p></div><div class="cms-heading-status"><span class="cms-status cms-status--<%= cmsUser.status || 'unknown' %>"><%= cmsUserStatusLabel %></span><strong><%= cmsUserRoleLabel %></strong></div></header>
  <%- include('../partials/feedback') %>
  <% if (cmsUserProtected) { %><div class="cms-alert cms-alert--warning" role="note"><strong>受保护的管理员账号</strong><p><%= cmsUserSelf ? '不能暂停或降级当前登录的自己。' : '不能暂停或降级最后一名有效管理员。' %></p></div><% } %>
  <div class="cms-detail-grid"><div class="cms-detail-main">
    <section class="cms-panel" aria-labelledby="user-profile-title"><header class="cms-panel__heading"><div><p class="cms-eyebrow">账号摘要</p><h2 id="user-profile-title">资料与治理状态</h2></div><a href="/users/<%= encodeURIComponent(cmsUser.username || '') %>">查看公开主页</a></header><dl class="cms-definition-grid"><div><dt>显示名</dt><dd><%= cmsUser.displayName || cmsUser.display_name || '—' %></dd></div><div><dt>用户名</dt><dd>@<%= cmsUser.username || '—' %></dd></div><div><dt>角色</dt><dd><%= cmsUserRoleLabel %></dd></div><div><dt>状态</dt><dd><%= cmsUserStatusLabel %></dd></div><div><dt>治理版本</dt><dd><%= cmsUserVersion %></dd></div><div><dt>注册时间</dt><dd><%= cmsUserDate(cmsUser.createdAt || cmsUser.created_at) %></dd></div><div class="cms-definition-grid__wide"><dt>公开简介</dt><dd><%= cmsUser.bio || '未填写简介' %></dd></div></dl></section>
    <section class="cms-panel" aria-labelledby="user-videos-title"><header class="cms-panel__heading"><div><p class="cms-eyebrow">近期内容</p><h2 id="user-videos-title">视频</h2></div><p><%= cmsUserVideoTotal %> 份（显示最近 <%= Math.min(20, cmsUserVideos.length) %> 份）</p></header><% if (!cmsUserVideos.length) { %><div class="cms-empty"><p>没有可展示的视频。</p></div><% } else { %><ul class="cms-link-list"><% cmsUserVideos.slice(0, 20).forEach(function(video) { %><li><a href="/cms/videos/<%= video.id %>"><%= video.title || video.id %></a><span><%= video.validationStatus || video.validation_status || '未知技术状态' %> · <%= video.moderationStatus || video.moderation_status || 'visible' %></span></li><% }); %></ul><% } %></section>
    <section class="cms-panel" aria-labelledby="user-discussions-title"><header class="cms-panel__heading"><div><p class="cms-eyebrow">近期内容</p><h2 id="user-discussions-title">讨论</h2></div><p><%= cmsUserDiscussionTotal %> 条（显示最近 <%= Math.min(20, cmsUserDiscussions.length) %> 条）</p></header><% if (!cmsUserDiscussions.length) { %><div class="cms-empty"><p>没有可展示的讨论。</p></div><% } else { %><ul class="cms-link-list"><% cmsUserDiscussions.slice(0, 20).forEach(function(item) { %><li><a href="/cms/discussions/<%= item.id %>"><%= item.title || item.bodyPreview || item.bodyMarkdown?.slice(0, 80) || ('讨论 #' + item.id) %></a><span><%= item.moderationStatus || item.moderation_status || 'visible' %> · <%= cmsUserDate(item.createdAt || item.created_at) %></span></li><% }); %></ul><% } %></section>
    <section class="cms-panel" aria-labelledby="user-sessions-title"><header class="cms-panel__heading"><div><p class="cms-eyebrow">安全</p><h2 id="user-sessions-title">活动会话</h2></div><p><%= cmsUserSessions.length %> 个</p></header><% if (!cmsUserSessions.length) { %><div class="cms-empty"><p>当前没有活动会话。</p></div><% } else { %><div class="cms-table-wrap"><table class="cms-table"><caption class="cms-visually-hidden">活动会话</caption><thead><tr><th scope="col">创建</th><th scope="col">到期</th><th scope="col">后台再认证</th></tr></thead><tbody><% cmsUserSessions.forEach(function(session) { %><tr><td data-label="创建"><%= cmsUserDate(session.createdAt || session.created_at) %></td><td data-label="到期"><%= cmsUserDate(session.expiresAt || session.expires_at) %></td><td data-label="后台再认证"><%= session.cmsVerifiedAt || session.cms_verified_at ? cmsUserDate(session.cmsVerifiedAt || session.cms_verified_at) : '未验证' %></td></tr><% }); %></tbody></table></div><% } %></section>
    <section class="cms-panel" aria-labelledby="user-history-title"><header class="cms-panel__heading"><div><p class="cms-eyebrow">只追加记录</p><h2 id="user-history-title">账号治理历史</h2></div></header><% if (!cmsUserActions.length) { %><div class="cms-empty"><p>尚无账号治理动作。</p></div><% } else { %><ol class="cms-timeline"><% cmsUserActions.forEach(function(action) { %><li><div><strong><%= action.actionLabel || action.actionType || action.action %></strong><time datetime="<%= action.createdAt || action.created_at || '' %>"><%= cmsUserDate(action.createdAt || action.created_at) %></time></div><p><%= action.publicReason || action.public_reason || '未提供公开说明' %></p><small><%= action.actorName || action.actorDisplayName || action.actorUsername || '系统' %></small></li><% }); %></ol><% } %></section>
  </div>
  <aside class="cms-detail-side" aria-label="账号治理操作"><section class="cms-panel cms-panel--sticky" aria-labelledby="user-actions-title"><header class="cms-panel__heading"><div><h2 id="user-actions-title">管理员操作</h2></div></header>
    <% if (cmsUser.status !== 'disabled') { %><form class="cms-form cms-action-form" action="/cms/users/<%= cmsUser.id %>/<%= cmsUser.status === 'suspended' ? 'restore' : 'suspend' %>" method="post" data-confirm-message="确定<%= cmsUser.status === 'suspended' ? '恢复' : '暂停' %>这个账号吗？"><input type="hidden" name="_csrf" value="<%= cmsUserCsrf %>"><input type="hidden" name="expectedVersion" value="<%= cmsUserVersion %>"><label class="cms-field"><span>公开说明 <em>必填</em></span><textarea name="publicReason" minlength="20" maxlength="2000" rows="4" required></textarea></label><label class="cms-field"><span>内部备注 <em>必填</em></span><textarea name="internalNote" minlength="5" maxlength="2000" rows="3" required></textarea></label><button class="cms-button <%= cmsUser.status === 'suspended' ? 'cms-button--primary' : 'cms-button--danger' %> cms-button--block" type="submit"<% if (cmsUserProtected && cmsUser.status !== 'suspended') { %> disabled aria-disabled="true"<% } %>><%= cmsUser.status === 'suspended' ? '恢复账号' : '暂停并撤销全部会话' %></button></form><% } %>
    <details class="cms-disclosure"><summary>设置工作人员角色</summary><form class="cms-form" action="/cms/users/<%= cmsUser.id %>/role" method="post" data-confirm-message="确定修改这个账号的后台角色吗？旧后台权限会立即失效。"><input type="hidden" name="_csrf" value="<%= cmsUserCsrf %>"><input type="hidden" name="expectedVersion" value="<%= cmsUserVersion %>"><label class="cms-field"><span>角色 <em>必填</em></span><select name="role" required><option value="member"<% if (cmsUser.role === 'member') { %> selected<% } %>>成员</option><option value="moderator"<% if (cmsUser.role === 'moderator') { %> selected<% } %>>审核员</option><option value="administrator"<% if (cmsUser.role === 'administrator') { %> selected<% } %>>管理员</option></select></label><label class="cms-field"><span>公开说明 <em>必填</em></span><textarea name="publicReason" minlength="20" maxlength="2000" rows="3" required></textarea></label><label class="cms-field"><span>内部备注 <em>必填</em></span><textarea name="internalNote" minlength="5" maxlength="2000" rows="3" required></textarea></label><button class="cms-button cms-button--warning cms-button--block" type="submit"<% if (cmsUserProtected) { %> disabled aria-disabled="true"<% } %>>保存角色</button></form></details>
    <details class="cms-disclosure cms-disclosure--danger"><summary>撤销全部会话</summary><form class="cms-form" action="/cms/users/<%= cmsUser.id %>/sessions/revoke" method="post" data-confirm-message="确定撤销该账号的全部登录会话吗？"><input type="hidden" name="_csrf" value="<%= cmsUserCsrf %>"><input type="hidden" name="expectedVersion" value="<%= cmsUserVersion %>"><label class="cms-field"><span>操作理由 <em>必填</em></span><textarea name="internalReason" minlength="10" maxlength="2000" rows="3" required></textarea></label><button class="cms-button cms-button--danger cms-button--block" type="submit">撤销全部会话</button></form></details>
  </section></aside></div>
<%- include('../partials/page-end') %>
