<%
  const cmsUsers = typeof users !== 'undefined' && Array.isArray(users) ? users : [];
  const cmsUserFilters = typeof filters !== 'undefined' && filters && typeof filters === 'object' ? filters : {};
  const cmsUserDate = function(value) { const date = value ? new Date(value) : null; return date && !Number.isNaN(date.getTime()) ? new Intl.DateTimeFormat('zh-CN', { dateStyle: 'medium', timeStyle: 'short' }).format(date) : '—'; };
  const cmsUserRole = function(value) { return ({ member: '成员', moderator: '审核员', administrator: '管理员' })[value] || value || '成员'; };
  const cmsUserStatus = function(value) { return ({ active: '正常', suspended: '已暂停', disabled: '已终止' })[value] || value || '未知'; };
%>
<%- include('../partials/page-start', { pageTitle: '账号｜同见管理后台', currentPath: '/cms/users' }) %>
  <header class="cms-page-heading"><div><p class="cms-eyebrow">仅管理员</p><h1>账号</h1><p>管理账号状态、工作人员角色和会话。CMS V1 不提供将账号设为 disabled 的动作。</p></div></header>
  <%- include('../partials/feedback') %>
  <form class="cms-filter-bar" action="/cms/users" method="get" aria-label="筛选账号"><label><span>状态</span><select name="status"><option value="">全部</option><option value="active"<% if (cmsUserFilters.status === 'active') { %> selected<% } %>>正常</option><option value="suspended"<% if (cmsUserFilters.status === 'suspended') { %> selected<% } %>>已暂停</option><option value="disabled"<% if (cmsUserFilters.status === 'disabled') { %> selected<% } %>>已终止</option></select></label><label><span>角色</span><select name="role"><option value="">全部</option><option value="member"<% if (cmsUserFilters.role === 'member') { %> selected<% } %>>成员</option><option value="moderator"<% if (cmsUserFilters.role === 'moderator') { %> selected<% } %>>审核员</option><option value="administrator"<% if (cmsUserFilters.role === 'administrator') { %> selected<% } %>>管理员</option></select></label><label class="cms-filter-bar__search"><span>关键词</span><input type="search" name="q" maxlength="120" value="<%= cmsUserFilters.q || '' %>" placeholder="用户名或显示名"></label><button class="cms-button cms-button--primary" type="submit">筛选</button><a class="cms-button cms-button--quiet" href="/cms/users">清除</a></form>
  <section class="cms-panel" aria-labelledby="user-list-title"><header class="cms-panel__heading"><div><h2 id="user-list-title">账号列表</h2><p><%= typeof pagination !== 'undefined' && pagination?.total !== undefined ? Number(pagination.total) : cmsUsers.length %> 个结果</p></div></header>
  <% if (!cmsUsers.length) { %><div class="cms-empty"><h3>没有符合条件的账号</h3><p>调整筛选条件后再试。</p></div><% } else { %><div class="cms-table-wrap"><table class="cms-table"><caption class="cms-visually-hidden">账号列表</caption><thead><tr><th scope="col">账号</th><th scope="col">角色</th><th scope="col">状态</th><th scope="col">视频</th><th scope="col">讨论</th><th scope="col">注册时间</th><th scope="col"><span class="cms-visually-hidden">操作</span></th></tr></thead><tbody><% cmsUsers.forEach(function(user) { const own = typeof currentUser !== 'undefined' && String(user.id || '') === String(currentUser?.id || ''); %><tr><td data-label="账号"><% if (own) { %><strong><%= user.displayName || user.display_name || user.username || user.id %></strong><% } else { %><a href="/cms/users/<%= user.id %>"><%= user.displayName || user.display_name || user.username || user.id %></a><% } %><small class="cms-cell-note">@<%= user.username || '—' %><% if (own) { %> · 本人账号<% } %></small></td><td data-label="角色"><span class="cms-role cms-role--<%= user.role || 'member' %>"><%= cmsUserRole(user.role) %></span></td><td data-label="状态"><span class="cms-status cms-status--<%= user.status || 'unknown' %>"><%= cmsUserStatus(user.status) %></span></td><td data-label="视频"><%= Number(user.videoCount ?? user.video_count ?? 0) %></td><td data-label="讨论"><%= Number(user.discussionCount ?? user.discussion_count ?? 0) %></td><td data-label="注册时间"><time datetime="<%= user.createdAt || user.created_at || '' %>"><%= cmsUserDate(user.createdAt || user.created_at) %></time></td><td data-label="操作"><% if (own) { %><a class="cms-row-link" href="/account/settings">账号设置</a><% } else { %><a class="cms-row-link" href="/cms/users/<%= user.id %>">查看</a><% } %></td></tr><% }); %></tbody></table></div><% } %></section>
  <%- include('../partials/pagination', { basePath: '/cms/users', queryString: typeof paginationQuery === 'string' ? paginationQuery : '' }) %>
<%- include('../partials/page-end') %>
