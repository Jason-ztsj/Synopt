<%
  const editorDialogId = typeof formulaEditorId === 'string' && formulaEditorId
    ? formulaEditorId
    : 'formula-editor';
  const editorTitleId = editorDialogId + '-title';
  const editorHelpId = editorDialogId + '-help';
%>
<div class="formula-editor" data-formula-editor hidden>
  <div class="formula-toolbar" data-formula-toolbar aria-label="公式工具">
    <span class="formula-toolbar__label">公式</span>
    <button class="formula-toolbar__button" type="button" data-formula-open="inline" aria-haspopup="dialog" aria-controls="<%= editorDialogId %>">
      <span aria-hidden="true">ƒ(x)</span>
      行内公式
    </button>
    <button class="formula-toolbar__button" type="button" data-formula-open="block" aria-haspopup="dialog" aria-controls="<%= editorDialogId %>">
      <span aria-hidden="true">∑</span>
      独立公式
    </button>
    <span class="formula-toolbar__hint">光标放在已有公式中可以继续编辑</span>
  </div>

  <div id="<%= editorDialogId %>" class="formula-dialog" data-formula-dialog role="dialog" aria-modal="true" aria-labelledby="<%= editorTitleId %>" aria-describedby="<%= editorHelpId %>" hidden>
    <div class="formula-dialog__surface" data-formula-surface>
      <header class="formula-dialog__header">
        <div>
          <p class="formula-dialog__eyebrow">可视化公式编辑器</p>
          <h4 id="<%= editorTitleId %>" data-formula-title>插入公式</h4>
        </div>
        <button class="formula-dialog__close" type="button" data-formula-cancel aria-label="关闭公式编辑器">×</button>
      </header>

      <div class="formula-mode" aria-label="公式显示方式">
        <button type="button" data-formula-mode="inline" aria-pressed="true">行内 <code>$…$</code></button>
        <button type="button" data-formula-mode="block" aria-pressed="false">独立成行 <code>$$…$$</code></button>
      </div>

      <div class="formula-field-wrap">
        <div class="formula-field-host" data-formula-field-host></div>
        <p id="<%= editorHelpId %>" class="formula-field-wrap__hint">下方公式键盘提供数字、符号和常用结构；分数、根号等结构会自动将光标移到待填位置。也可以使用实体键盘或粘贴 LaTeX。</p>
      </div>

      <p class="formula-dialog__status" data-formula-status aria-live="polite"></p>
      <footer class="formula-dialog__footer">
        <button class="formula-dialog__secondary" type="button" data-formula-cancel>取消</button>
        <button class="formula-dialog__primary" type="button" data-formula-commit>插入到 Markdown</button>
      </footer>
    </div>
  </div>
</div>
