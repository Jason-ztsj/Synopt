<%
  const author = node.accountDisplayName || node.accountUsername || node.nickname || '历史观众';
  const isTopic = depth === 0;
  const title = node.title || plainPreview(node.bodyMarkdown).slice(0, 60) || '历史讨论';
  const nestedDepth = Math.min(depth, 5);
%>
<% if (isTopic) { %>
<details class="discussion-thread" id="discussion-<%= node.id %>" data-discussion-details>
  <summary>
    <span class="thread-score" aria-label="净认同数"><%= node.upvoteCount - node.downvoteCount %></span>
    <span class="thread-summary"><strong><%= title %></strong><small><%= author %> · <%= discussionDate(node.createdAt) %> · <%= node.replies.length %> 条直接回复</small><span><%= plainPreview(node.bodyMarkdown) %></span></span>
    <span class="thread-expand">展开</span>
  </summary>
  <div class="thread-content">
<% } else { %>
<article class="discussion-reply" id="discussion-<%= node.id %>" style="--reply-depth:<%= nestedDepth %>">
<% } %>
    <header class="discussion-meta"><span class="discussion-meta__avatar" aria-hidden="true"><%= Array.from(String(author))[0] || '用' %></span><p><strong><%= author %></strong><time datetime="<%= node.createdAt %>"><%= discussionDate(node.createdAt) %></time></p></header>
    <div class="markdown-body discussion-copy"><%- node.renderedBody %></div>
    <div class="discussion-actions">
      <% if (user) { %>
        <form action="/discussions/<%= node.id %>/vote" method="post" data-vote-form data-vote-kind="up"><input type="hidden" name="_csrf" value="<%= safeCsrfToken %>"><input type="hidden" name="value" value="<%= node.viewerVote === 1 ? 0 : 1 %>"><button type="submit" class="<%= node.viewerVote === 1 ? 'is-active' : '' %>">认同 <strong data-upvotes><%= node.upvoteCount %></strong></button></form>
        <form action="/discussions/<%= node.id %>/vote" method="post" data-vote-form data-vote-kind="down"><input type="hidden" name="_csrf" value="<%= safeCsrfToken %>"><input type="hidden" name="value" value="<%= node.viewerVote === -1 ? 0 : -1 %>"><button type="submit" class="<%= node.viewerVote === -1 ? 'is-active is-negative' : '' %>">反对 <strong data-downvotes><%= node.downvoteCount %></strong></button></form>
        <details class="reply-composer"><summary>回复</summary><form action="/videos/<%= videoId %>/discussions" method="post"><input type="hidden" name="_csrf" value="<%= safeCsrfToken %>"><input type="hidden" name="parentId" value="<%= node.id %>"><textarea name="body" rows="4" maxlength="5000" required placeholder="回复 <%= author %>；支持 Markdown 和 LaTeX"></textarea><button class="button button--quiet" type="submit">发布回复</button></form></details>
      <% } else { %><a href="/login?next=<%= encodeURIComponent('/videos/' + videoId + '#discussion-' + node.id) %>">登录后认同或回复</a><% } %>
    </div>
    <% if (node.replies.length) { %><div class="reply-list"><% node.replies.forEach(function(reply) { %><%- include('discussion-node', { node: reply, depth: depth + 1, videoId: videoId, user: user, safeCsrfToken: safeCsrfToken, discussionDate: discussionDate, plainPreview: plainPreview }) %><% }); %></div><% } %>
<% if (isTopic) { %>
  </div>
</details>
<% } else { %>
</article>
<% } %>
