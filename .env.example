# HTTP 监听端口。
PORT=3000

# Compose 在宿主机上的发布地址。默认只允许本机访问；若需局域网访问，
# 可填写开发板的具体 LAN 地址（例如 192.168.10.24），或在可信网络内临时
# 使用 0.0.0.0。直接运行 Node 时应用会监听 0.0.0.0，便于无显示器开发板调试。
HOST_BIND_ADDRESS=127.0.0.1

# 本机运行时的数据路径；为兼容既有 MVP 数据库，文件名暂时保留 gongying。
# Compose 会固定改为 /app/data 下的路径。
DATABASE_PATH=./data/gongying.sqlite
VIDEO_STORAGE_PATH=./data/videos

# 单个规范化媒体文件最大体积（MiB）。默认 90，并为反向代理的请求体限制预留 multipart 开销。
MAX_UPLOAD_MB=90

# 服务端媒体验证边界。容器与编码仍会由 ffprobe 独立确认，不能只相信浏览器上报。
MAX_VIDEO_DURATION_SECONDS=7200
MAX_VIDEO_WIDTH=4096
MAX_VIDEO_HEIGHT=4096
MAX_VIDEO_PIXELS=8847360
MAX_VIDEO_FPS=120

# 允许的基础解码失败比例；程序还会给短片至少 3 帧容忍，并限制最长等效损坏量。
MEDIA_DECODE_ERROR_RATE=0.001
MEDIA_VALIDATION_POLL_MS=1000
MEDIA_VALIDATION_STALE_MINUTES=30
MEDIA_VALIDATION_THREADS=2

# 直接在宿主机运行 validator 时使用；Compose 会固定为镜像内的 /usr/bin 路径。
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg

# Compose 中独立验证服务的硬资源边界。默认一次只验证一个作品。
VALIDATOR_CPUS=2.0
VALIDATOR_MEMORY_LIMIT=1536m
VALIDATOR_PIDS_LIMIT=64

# 同一账号或来源 IP 连续发帖的最短间隔（秒）。
DISCUSSION_COOLDOWN_SECONDS=30

# 注册或登录尝试的最短间隔（秒）。
AUTH_COOLDOWN_SECONDS=2

# 登录会话有效期（小时）。
SESSION_TTL_HOURS=168

# 若以后仅经 HTTPS（例如 Cloudflare Tunnel）试验访问则设为 true；局域网 HTTP 保持 false。
SESSION_COOKIE_SECURE=false

# direct：只相信 TCP 连接地址；cloudflare：读取合法的单值 CF-Connecting-IP。
CLIENT_IP_MODE=direct
