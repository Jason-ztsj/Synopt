# HTTP 监听端口。
PORT=3000

# Compose 在宿主机上的发布地址。默认只允许本机访问；若需局域网访问，
# 可填写本机的具体 LAN 地址（例如 192.168.10.24），或在可信网络内临时
# 使用 0.0.0.0。直接运行 Node 时应用会监听 0.0.0.0，便于无显示器机器局域网调试。
HOST_BIND_ADDRESS=127.0.0.1

# 本机运行时的数据路径（SQLite 数据库文件）。
# Compose 会固定改为 /app/data 下的路径。
DATABASE_PATH=./data/synopt.sqlite
VIDEO_STORAGE_PATH=./data/videos

# 单个规范化媒体文件最大体积（MiB）。默认 1024。受限于反向代理/隧道请求体上限时，
# 请配合分片上传使用；并为 multipart 开销预留空间。
MAX_UPLOAD_MB=1024

# 分片上传时单片大小（MiB）。默认 16，远低于 Cloudflare 隧道 100 MB 的单请求限制。
# 大文件（客户端阈值约 50 MiB）会自动走分片，小文件保持一次性上传。
MEDIA_UPLOAD_CHUNK_MB=16

# 服务端媒体验证边界。容器与编码仍会由 ffprobe 独立确认，不能只相信浏览器上报。
MAX_VIDEO_DURATION_SECONDS=7200
MAX_VIDEO_WIDTH=4096
MAX_VIDEO_HEIGHT=4096
MAX_VIDEO_PIXELS=8847360
MAX_VIDEO_FPS=120

# 允许的基础解码失败比例；程序还会给短片至少 3 帧容忍，并限制最长等效损坏量。
MEDIA_DECODE_ERROR_RATE=0.001
MEDIA_VALIDATION_POLL_MS=1000
# validating 任务会在解码期间续租；worker 中断且超过该时间后才允许其他 worker 重领。
MEDIA_VALIDATION_STALE_MINUTES=30
MEDIA_VALIDATION_THREADS=2

# 直接在宿主机运行 validator 时使用；Compose 会固定为镜像内的 /usr/bin 路径。
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg

# 用户头像/封面在 Web 请求内进行真实解码和去元数据规范化。并发满载时立即返回可重试错误；
# 同一账号或来源 IP 连续触发规范化还会受到冷却限制。
IMAGE_NORMALIZATION_CONCURRENCY=2
IMAGE_NORMALIZATION_COOLDOWN_SECONDS=10

# Compose 中 Web 服务（含图片规范化子进程）的硬资源边界。
APP_CPUS=2.0
APP_MEMORY_LIMIT=1024m
APP_PIDS_LIMIT=96

# Compose 中独立验证服务的硬资源边界。默认一次只验证一个作品。
VALIDATOR_CPUS=2.0
VALIDATOR_MEMORY_LIMIT=1536m
VALIDATOR_PIDS_LIMIT=64

# 同一账号或来源 IP 连续发帖的最短间隔（秒）。
DISCUSSION_COOLDOWN_SECONDS=30

# 注册和登录按来源 IP 计算的最短间隔（秒）；
# CMS 密码再认证也复用该值，并同时按工作人员账号和来源 IP 计算。
AUTH_COOLDOWN_SECONDS=2

# 登录会话有效期（小时）。
SESSION_TTL_HOURS=168

# CMS 沿用普通账号会话，但工作人员进入后台前必须再次输入密码。
# 再认证只作用于属于当前工作人员的当前会话；私密媒体授权还会绑定当前会话、案件和视频，
# 并在案件转交或结案时失效。
CMS_REAUTH_MINUTES=30
CMS_PRIVATE_MEDIA_GRANT_MINUTES=15

# 同一账号或来源 IP 连续提交举报的最短间隔（单进程内存）。
REPORT_COOLDOWN_SECONDS=30

# 可申诉审核动作的期限；同一期限也用于保留作者尚可申诉或申诉未结束时的
# 视频/讨论治理证据，阻止编辑或删除尚在保留期的讨论，以及删除尚在保留期的视频。
APPEAL_WINDOW_DAYS=30

# 若以后仅经 HTTPS（例如 Cloudflare Tunnel）试验访问则设为 true；局域网 HTTP 保持 false。
SESSION_COOKIE_SECURE=false

# direct：只相信 TCP 连接地址；cloudflare：读取合法的单值 CF-Connecting-IP。
CLIENT_IP_MODE=direct
