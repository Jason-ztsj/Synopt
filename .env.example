# HTTP 监听端口。
PORT=3000

# Compose 在宿主机上的发布地址。默认只允许本机访问；若需局域网访问，
# 请填写开发板的具体 LAN 地址（例如 192.168.10.24），避免直接使用 0.0.0.0。
HOST_BIND_ADDRESS=127.0.0.1

# 本机运行时的数据路径；Compose 会固定改为 /app/data 下的路径。
DATABASE_PATH=./data/gongying.sqlite
VIDEO_STORAGE_PATH=./data/videos

# 单个 MP4 最大体积（MiB）。默认 90，为 Cloudflare 100 MB 请求上限预留 multipart 开销。
MAX_UPLOAD_MB=90

# 同一来源 IP 连续发帖的最短间隔（秒）。
DISCUSSION_COOLDOWN_SECONDS=30

# direct：只相信 TCP 连接地址；cloudflare：读取合法的单值 CF-Connecting-IP。
CLIENT_IP_MODE=direct
